            <property name="borderRightStyle">none</property>
            <property name="borderTopStyle">none</property>
            <property name="contentType">html</property>
            <text-property name="content"><![CDATA[प्रिय <B><VALUE-OF>params["memberName"]</VALUE-OF></B>, सदस्य आईडी <B><VALUE-OF>params["memberId"]</VALUE-OF></B>, आपके द्वारा <B><VALUE-OF>params["applicationDate"]</VALUE-OF></B> को आवेदन किया गया ऋण स्वीकृत कर दिया गया है।  इसके विवरण नीचे दिए गए हैं। ऋण प्रक्रिया को आगे बढ़ाने के लिए कृपया नीचे बताए गए मूल दस्तावेज़ों के साथ नीचे दिए गए दस्तावेज़ भी साथ लाएँ।]]></text-property>
        </text>
