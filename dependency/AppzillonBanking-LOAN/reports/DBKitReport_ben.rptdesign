                                    <property name="contentType">auto</property>
                                    <text-property name="content"><![CDATA[আমি এতদ্বারা নিশ্চিত করছি যে আমি নিজে গ্রাহকের আসল KYC নথি এবং ব্যাঙ্ক পাসবই যাচাই করেছি।
আমি, এতদ্বারা, নিশ্চিত করছি যে প্রদত্ত ঋণটি সিএজিএল-এর ESMS নীতি অনুসারে দেওয়া হয়েছে।]]></text-property>
