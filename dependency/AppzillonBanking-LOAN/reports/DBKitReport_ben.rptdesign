                    <text id="191">
                        <property name="fontFamily">serif</property>
                        <property name="fontSize">8pt</property>
                        <property name="fontWeight">bold</property>
                        <property name="textUnderline">underline</property>
                        <property name="marginTop">0pt</property>
                        <property name="marginBottom">0pt</property>
                        <property name="paddingTop">0pt</property>
                        <property name="paddingLeft">0pt</property>
                        <property name="paddingBottom">0pt</property>
                        <property name="paddingRight">0pt</property>
                        <property name="textAlign">left</property>
                        <property name="contentType">html</property>
                        <text-property name="content"><![CDATA[<B>সদস্যের ঘোষণা:</B>]]></text-property>
                    </text>
                    <text-data id="912877">
                        <property name="fontSize">8pt</property>
                        <expression name="valueExpr">if (&#13;
    params["pdtName"].value == "GL.IGL.VISH.LN" &#13;
    || params["pdtName"].value == "GL.GRM.VISH.SUPPL" &#13;
    || params["customerType"].value == "IL"&#13;
) {&#13;
&#13;
    "আমি ক্রেডিটএক্সেস গ্রামীণ লিমিটেড (এখন থেকে যেটি সিএজিএল নামে পরিচিত),"&#13;
    &#13;
    + "&lt;b>" + params["branchName"].value + "&lt;/b> শাখাকে অনুরোধ করছি যে তারা "&#13;
    + "&lt;b>" + params["apiResDateTime"].value.split(" ")[0] + "&lt;/b>  তারিখের আমার দ্বারা যথাযথভাবে সম্পাদিতপ্রমিসরি নোটটি  টাকা "&#13;
    + "&lt;b>Rs." + params["approvedAmtInRupees"].value + "&lt;/b> "&#13;
    + "&lt;b>(টাকা " + params["approvedAmtInWord"].value + "&lt;/b>) "&#13;
&#13;
    + "গ্রহণ করুক, যার জন্য আমি অর্থ গ্রহণ করেছি। আমি এতদ্বারা ঋণের পরিমাণ"&#13;
    + params["term"].value + "&lt;/b> সমান &lt;b>" &#13;
    + (&#13;
    params["paymentFreq"].value == "BI-WEEKLY" ? "2-weekly" :&#13;
    params["paymentFreq"].value == "FOUR-WEEKLY" ? "4-weekly" :&#13;
    params["paymentFreq"].value&#13;
  ) + "&lt;/b>কিস্তিতে সুদ সহ পরিশোধ করার অঙ্গীকার করছি। আমি এই দ্বারা নিশ্চিত করছি যে আমি সিএজিএল-এর একজন ব্যক্তিগত সদস্য হিসেবে ঋণের পরিমাণ গ্রহণ করেছি। আমি আরও প্রত্যয়িত করি যে আমি, আমার নিকট ক্রেডিটঅ্যাক্সেস গ্রামীণ লিমিটেড কর্মীদের দ্বারা ব্যাখ্যাকৃত অনুসারে ঋণ রাশি, সুদের হার, কিস্তির রাশি, এবং পরিশোধের সময়তালিকা সম্পর্কে আমার অধিকার এবং দায়িত্বগুলির সম্পূর্ণরূপে বুঝি এবং তাঁরা ঋণটির সম্পর্কে আমার সম্পূর্ণ সন্তুষ্টি মতো বিস্তারিত বিররণ প্রদান করেছেন।আমি সম্মত সময়সূচি অনুযায়ী ঋণের মূল টাকা এবং/অথবা সুদ পরিশোধ করতে দায়বদ্ধ থাকব, এবং তাদের প্রাপ্য অর্থ আদায়ের জন্য সিএজিএল আমার বিরুদ্ধে প্রযোজ্য আইনগত ব্যবস্থা গ্রহণ করতে পারে।  ঋণটির অপ-ব্যবহার অথবা ঋণের যেকোনো শর্তের লঙ্ঘনের ঘটনার ক্ষেত্রে, ক্রেডিটঅ্যাক্সেস গ্রামীণ লিমিটেডের কাছে, তাদের বিবেচনার অধীনে, ঋণটি প্রচলিত থাকাকালীন সেটি ফেরত চাওয়ার অধিকার আছে। আমি আরও ঘোষণা করি যে আমি উপরের উল্লেখিত কর্জ পত্রটি নিষ্পাদিত করেছি এবং এই ঘোষণাটি করেছি যখন আমি শারীরিক এবং মানসিকভাবে সুস্থ ছিলাম এবং যে আমি আজকের তারিখে কোনও প্রকার গুরুতর অসুস্থতায় আক্রান্ত নই। ";&#13;
&#13;
} else {&#13;
&#13;
    "আমি ক্রেডিটএক্সেস গ্রামীণ লিমিটেড (এখন থেকে যেটি সিএজিএল নামে পরিচিত),"&#13;
    &#13;
    + "&lt;b>" + params["branchName"].value + "&lt;/b> শাখাকে অনুরোধ করছি যে তারা "&#13;
    + "&lt;b>" + params["apiResDateTime"].value.split(" ")[0] + "&lt;/b>  তারিখের আমার দ্বারা যথাযথভাবে সম্পাদিতপ্রমিসরি নোটটি  টাকা "&#13;
    + "&lt;b>Rs." + params["approvedAmtInRupees"].value + "&lt;/b> "&#13;
    + "&lt;b>(টাকা" + params["approvedAmtInWord"].value + "&lt;/b>) "&#13;
&#13;
    + "গ্রহণ করুক, যার জন্য আমি অর্থ গ্রহণ করেছি। আমি এতদ্বারা ঋণের পরিমাণ"&#13;
    + params["term"].value + "&lt;/b> সমান &lt;b>" &#13;
    + (&#13;
    params["paymentFreq"].value == "BI-WEEKLY" ? "2-weekly" :&#13;
    params["paymentFreq"].value == "FOUR-WEEKLY" ? "4-weekly" :&#13;
    params["paymentFreq"].value&#13;
  ) + "&lt;/b>কিস্তিতে সুদ সহ পরিশোধ করার অঙ্গীকার করছি। আমি এতদ্বারা প্রত্যয়িত করি যে আমি, সিএজিএল যুগ্ম দায়বদ্ধতাভিত্তিক গোষ্ঠীর (জয়েন্ট লায়াবিলিটি গ্রুপ) সদস্য হিসাবে ঋণ রাশিটি গ্রহণ করেছি। আমি আরও প্রত্যয়িত করি যে আমি, আমার নিকট ক্রেডিটঅ্যাক্সেস গ্রামীণ লিমিটেড কর্মীদের দ্বারা ব্যাখ্যাকৃত অনুসারে ঋণ রাশি, সুদের হার, কিস্তির রাশি, এবং পরিশোধের সময়তালিকা সম্পর্কে আমার অধিকার এবং দায়িত্বগুলির সম্পূর্ণরূপে বুঝি এবং তাঁরা ঋণটির সম্পর্কে আমার সম্পূর্ণ সন্তুষ্টি মতো বিস্তারিত বিররণ প্রদান করেছেন। তাই, আমি সম্মত সময়তালিকা অনুসারে ঋণের রাশিটি এবং / অথবা সুদ পরিশোধ করার জন্য পৃথকভাবে এবং গোষ্ঠীটির অন্যান্য সদস্যদের সঙ্গে যুগ্মভাবে দায়বদ্ধ থাকব, এবং ক্রেডিটঅ্যাক্সেস গ্রামীণ লিমিটেড তাদের বকেয়াগুলি পুনরুদ্ধারের উদ্দেশ্যে, যুগ্মভাবে আমাদের এবং / অথবা পৃথকভাবে আমার বিরুদ্ধে উপযুক্ত আইনি পদক্ষেপ নিতে পারে | ঋণটির অপ-ব্যবহার অথবা ঋণের যেকোনো শর্তের লঙ্ঘনের ঘটনার ক্ষেত্রে, ক্রেডিটঅ্যাক্সেস গ্রামীণ লিমিটেডের কাছে, তাদের বিবেচনার অধীনে, ঋণটি প্রচলিত থাকাকালীন সেটি ফেরত চাওয়ার অধিকার আছে। আমি আরও ঘোষণা করি যে আমি উপরের উল্লেখিত কর্জ পত্রটি নিষ্পাদিত করেছি এবং এই ঘোষণাটি করেছি যখন আমি শারীরিক এবং মানসিকভাবে সুস্থ ছিলাম এবং যে আমি আজকের তারিখে কোনও প্রকার গুরুতর অসুস্থতায় আক্রান্ত নই। ";&#13;
}</expression>
                        <property name="contentType">html</property>
                    </text-data>
                    <text id="912876">
                        <property name="fontSize">7.5pt</property>
                        <property name="textAlign">justify</property>
                        <property name="contentType">html</property>
                        <text-property name="content"><![CDATA[আমি এতদ্বারা, আমার নিকট অতিরিক্ত উল্লেখ ব্যতিরেকেই ঋণগলিকে যেকোনো ব্যাঙ্ক / আর্থিক প্রতিষ্ঠানের নিকট বন্ধক প্রদানের, বিক্রয় করার, অর্পণ করার, জামিনভুক্ত করার অথবা নিষ্পত্তি করার জন্য ক্রেডিটঅ্যাক্সেস গ্রামীণ লিমিটেড অনুমোদিত করি। আমি, উক্ত গোষ্ঠীভিত্তিক বিমা স্কিমটির নিয়ম এবং শর্তাবলী সম্পূর্ণরূপে বোঝার পরে স্বেচ্ছায়, মাস্টার পলিসি হোল্ডার (MPH) হিসাবে ক্রেডিটঅ্যাক্সেস গ্রামীণ লিমিটেড দ্বারা প্রযুক্ত গোষ্ঠীভিত্তিক বিমা স্কিমের অধীনে তালিকাভুক্ত হওয়ার বিকল্পটি গ্রহণ করেছি।কোনো অপ্রত্যাশিত ঘটনা ঘটলে, আমি/আমরা এই মর্মে সম্মতি দিচ্ছি যে বীমা কোম্পানি দাবি অর্থের বিভাজিত পরিশোধ করতে পারবে। বকেয়া ঋণের পরিমাণ পর্যন্ত অর্থ CAGL-এর নামে প্রদান করা হবে এবং অবশিষ্ট দাবি অর্থ যথাযথভাবে মনোনীত ব্যক্তির (nominee) নামে প্রদান করা যেতে পারে। আমি স্বেচ্ছায় আমার ব্যক্তিগত এবং ঋণ সম্পর্কিত তথ্য শিল্প সহযোগী, ক্রেডিট ব্যুরো, কোম্পানীর নিকট ঋণ প্রদানকারী, যেকোনো বিধিবদ্ধ, নিয়ন্ত্রক এবং রেটিং এজেন্সির নিকট প্রকাশ করার জন্য ক্রেডিটঅ্যাক্সেস গ্রামীণ লিমিটেড কে অনুমোদিত করি, এবং তাঁরা উল্লেখিত পরিসংখ্যান এবং তথ্যগুলি নিয়ন্ত্রণ এবং অনুপালন সম্পর্কিত প্রয়োজনীয়তা পূরণের উদ্দেশ্যে একটি পন্থায় ব্যবহার করতে পারেন। আমি এতদ্বারা স্বেচ্ছায় আমার নিজের বিবেচনার ভিত্তিতে, আমার KYC-এর কপি, আমার পরিচয়/ঠিকানা প্রমাণ প্রতিষ্ঠার উদ্দেশ্যে সিএজিএল-এর কাছে জমা করি৷ ক্রেডিটঅ্যাক্সেস গ্রামীণ লিমিটেড আমাকে অবহিত করেছে যে এতদসঙ্গে জমা করা আমার KYC উপরে উল্লিখিত অথবা আইনভিত্তিক প্রয়োজনীয়তার উদ্দেশ্য বাতীত অন্য কোনো উদ্দেশ্যে ব্যবহৃত হবে না। । আমি এতদ্বারা, বিপণন ছাড়াও ক্রেডিটঅ্যাক্সেস গ্রামীণ লিমিটেড এর বাৎসরিক প্রতিবেদনে, রিপণন এবং প্রশিক্ষণ পুস্তিকাগুলিতে, আভ্যন্তরীণ অথবা বহিরাগত উদ্দেশো কেস স্টাডিগুলিতে, তৃতীয় পক্ষ পরামর্শদাতার মুদ্রিত প্রকাশনা এবং / অথবা অডিও- ভিজুয়াল কার্যক্রমগুলিতে ব্যবহারের উদ্দেশ্যে ওয়েবসাইটগুলির এবং অন্যান্য মাধ্যমগুলির দ্বারা আমার ছবি, নাম, গল্প এবং জিপিএস অবস্থান প্রকাশ করার জন্য অনুমতি প্রদান করি।  আমি সিএজিএল-কে  আমার ফোনে সব ধরনের বার্তা পাঠানোর অনুমতি দিচ্ছি।
]]></text-property>
                    </text>
