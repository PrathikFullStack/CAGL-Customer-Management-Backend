                                    <property name="contentType">auto</property>
                                    <text-property name="content"><![CDATA[ഉപഭോക്താവിന്റെ ഒറിജിനൽ KYC , ബാങ്ക് പാസ്ബുക്ക് എന്നിവ ഞാൻ പരിശോധിച്ച് ഉറപ്പുവരുത്തിയതായി ഇതിനാൽ സാക്ഷ്യപ്പെടുത്തുന്നു.]]></text-property>
                                </text>
