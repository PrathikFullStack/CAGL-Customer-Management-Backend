                    <text-data id="912883">
                        <property name="fontSize">8pt</property>
                        <expression name="valueExpr">"আমি এটি বুঝতে পেরেছি যে প্রযোজ্য মাশুল কেটে নেওয়ার পরে এবং বিদ্যমান ঋণ নির্ধারিত সময়ের পূর্বে পরিশোধ করার পরে আমি ব্যাঙ্ক ট্রান্সফারের মাধ্যমে এই টাকা &lt;B>Rs."+ parseInt(row["disbursementAmount"].replace("Rs.","").replace(/,/g,""))+"&lt;/B> &lt;B>(টাকায় "+numberToWords(parseInt(row["disbursementAmount"].replace("Rs.","").replace(/,/g,"")))+")&lt;/B> পাব:"</expression>
