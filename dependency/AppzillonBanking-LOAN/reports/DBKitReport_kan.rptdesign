    <body>
        <grid id="255">
            <property name="height">20.8125in</property>
            <property name="width">7.875in</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">fullAddress</property>
                    <text-property name="displayName">fullAddress</text-property>
                    <expression name="expression" type="javascript">params["fullAddress"]</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">OTP data</property>
                    <expression name="expression" type="javascript">"ಆತ್ಮೀಯ " +&#13;
(&#13;
  params["insurancePremium"].value != 0&#13;
    ? params["borrowerName"].value +&#13;
        (params["spouseInsurance"].value == "YES"&#13;
          ? " ಮತ್ತು " + params["coBorrowerName"].value&#13;
          : ""&#13;
        )&#13;
    : ""&#13;
) +&#13;
", ಸಾಲದ ID " + params["applicationId"].value +&#13;
" ಮತ್ತು ಸದರಿ ಸಾಲದ ಅಡಿಯಲ್ಲಿ (" +&#13;
params["borrowerName"].value +&#13;
(&#13;
  params["spouseInsurance"].value == "YES"&#13;
    ? " ಮತ್ತು " + params["coBorrowerName"].value&#13;
    : ""&#13;
) +&#13;
") ರಂದು ಜೀವ ವಿಮೆಯನ್ನು ಪಡೆಯಲು ನಿಮ್ಮ ಸಮ್ಮತಿಯಾಗಿ OTP " +&#13;
params["insurancePremium"].value +&#13;
" ಅನ್ನು ಹಂಚಿಕೊಂಡಿದ್ದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. ಯಾವುದೇ ದೂರುಗಳಿದ್ದಲ್ಲಿ 1800123153153 ಗೆ ಕರೆ ಮಾಡಿ-ಗ್ರಾಮೀಣ್ ಕೂಟ"</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">OTP Data</property>
                    <expression name="expression" type="javascript">"ಆತ್ಮೀಯ " +&#13;
(&#13;
  params["insurancePremium"].value != 0&#13;
    ? params["borrowerName"].value +&#13;
        (params["spouseInsurance"].value == "YES"&#13;
          ? " ಮತ್ತು " + params["coBorrowerName"].value&#13;
          : ""&#13;
        )&#13;
    : ""&#13;
) +&#13;
", ಸಾಲದ ID " + params["applicationId"].value +&#13;
" ಮತ್ತು ಸದರಿ ಸಾಲದ ಅಡಿಯಲ್ಲಿ " + "(OTP Authentication Date and time)" +&#13;
" ರಂದು ಜೀವ ವಿಮೆಯನ್ನು ಪಡೆಯಲು ನಿಮ್ಮ ಸಮ್ಮತಿಯಾಗಿ OTP " +&#13;
params["insurancePremium"].value +&#13;
" ಅನ್ನು ಹಂಚಿಕೊಂಡಿದ್ದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. ಯಾವುದೇ ದೂರುಗಳಿದ್ದಲ್ಲಿ 1800123153153 ಗೆ ಕರೆ ಮಾಡಿ-ಗ್ರಾಮೀಣ್ ಕೂಟ"</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount0</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount0"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount0"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount1</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount1"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount1"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount2</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount2"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount2"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
