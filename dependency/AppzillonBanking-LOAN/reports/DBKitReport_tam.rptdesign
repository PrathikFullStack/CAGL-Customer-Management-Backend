                                                <property name="contentType">auto</property>
                                                <text-property name="content"><![CDATA[## குரூப் மைக்ரோ லைஃப் காப்பீட்டு திட்டத்தின் கீழ் துணைவர் / இணை கடன் வாங்குபவர் ஆகியோரும் காப்பீட்டைப் பெறுபவர்களாக இருக்கும்பட்சத்தில், கடன் வாங்குபவர் இதன் நியமிக்கப்பட்ட வாரிசாக இருப்பார் ]]></text-property>
                                            </text>
                                        </cell>
                                    </row>
