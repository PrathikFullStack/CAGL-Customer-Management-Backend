                    <text id="191">
                        <property name="fontFamily">serif</property>
                        <property name="fontSize">7pt</property>
                        <property name="fontWeight">bold</property>
                        <property name="textUnderline">underline</property>
                        <property name="marginTop">1pt</property>
                        <property name="marginBottom">0pt</property>
                        <property name="paddingTop">0pt</property>
                        <property name="paddingBottom">0pt</property>
                        <property name="textAlign">justify</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[உறுப்பினர் அறிவிப்பு:]]></text-property>
                    </text>
                    <text-data id="912824">
                        <property name="fontSize">7pt</property>
                        <list-property name="visibility">
                            <structure>
                                <property name="format">all</property>
                                <expression name="valueExpr" type="javascript">params["insurancePremium"].value == 0</expression>
                            </structure>
                        </list-property>
                        <expression name="valueExpr">if (&#13;
    params["pdtName"].value == "GL.IGL.VISH.LN" ||&#13;
    params["pdtName"].value == "GL.GRM.VISH.SUPPL" ||&#13;
    params["customerType"].value == "IL"&#13;
) {&#13;
&#13;
    "நான் என்னால் பெறப்பட்ட பரிசீலனையின் பொருட்டு, என்னால் முறையாக செயல்படுத்தப்பட்ட, ரூ. "&#13;
    + "&lt;b>Rs." + params["approvedAmtInRupees"].value + "&lt;/b> "&#13;
    + "(ரூபாய் &lt;b>" + params["approvedAmtInWord"].value + "&lt;/b>) "&#13;
    + "எனும் தொகைக்கான "&#13;
    + "&lt;b>" + params["apiResDateTime"].value.split(" ")[0] + "&lt;/b> "&#13;
    + "தேதியிட்ட கடனுறுதிப் பத்திரத்தின் டெலிவரியை பெற்றுக்கொள்ளுமாறு கிரெடிட் ஆக்சஸ் கிராமீன் லிமிட்டெட் (இனிமேல் சிஏஜிஎல் என அழைக்கப்படுகிறது), "&#13;
    + "&lt;b>" + params["branchName"].value + "&lt;/b> கிளையை கேட்டுக்கொள்கிறேன். கடன் தொகையை "&#13;
    + "&lt;b>" + params["term"].value + "&lt;/b> சமமான &lt;b>"&#13;
    + (&#13;
    params["paymentFreq"].value == "BI-WEEKLY" ? "2-weekly" :&#13;
    params["paymentFreq"].value == "FOUR-WEEKLY" ? "4-weekly" :&#13;
    params["paymentFreq"].value&#13;
  ) + "&lt;/b> தவணைகளில் வட்டியுடன் திருப்பிச் செலுத்த நான் இதன்மூலம் உறுதியளிக்கிறேன். நான் இதன்மூலம், சிஏஜிஎல்-ன் தனிப்பட்ட உறுப்பினராக கடன் தொகையைப் பெற்றுக்கொண்டதை உறுதிப்படுத்துகிறேன்.சிஏஜிஎல் ஊழியர்கள் விவரித்தபடி, கடன் தொகை, வட்டி விகிதம், தவணைத் தொகை மற்றும் திருப்பிச் செலுத்தும் கால அட்டவணை குறித்த எனது உரிமைகள் மற்றும் பொறுப்புகளை நான் முழுமையாக புரிந்து கொண்டேன் என்பதையும், மேலும் அவர்கள் கடன் பற்றிய விவரங்கள் அனைத்தையும் எனக்கு முழு திருப்தி ஏற்படும் அளவுக்கு தெளிவுபடுத்தினர் என்பதையும் நான் உறுதிப்படுத்துகிறேன்.நான் ஒப்புக்கொள்ளப்பட்ட அட்டவணைப்படி கடன் தொகை மற்றும்/அல்லது வட்டியைக் கட்டுவதற்கு பொறுப்பாளினியாக இருப்பேன், மேலும் சிஏஜிஎல் அவர்களுக்கு வந்து சேர வேண்டிய தொகையை வசூலிப்பதற்காக எனக்கு எதிராக தகுந்த சட்ட நடவடிக்கைகளை மேற்கொள்ளலாம்.  மேலும் மேற்சொன்ன கடனுறுதிச் சீட்டை நான் செயல்படுத்தியுள்ளேன் என்பதையும், இந்த அறிவிப்பை நான் நல்ல மனதுடனும் ஆரோக்கியத்துடனும் இருக்கும்போது வெளியிட்டேன் மேலும், இந்த தேதியில் நான் எந்தவொரு தீவிர நோயாலும் பாதிக்கப்படவில்லை என்பதையும் நான் அறிவிக்கிறேன்.";&#13;
&#13;
} else {&#13;
&#13;
    "நான் என்னால் பெறப்பட்ட பரிசீலனையின் பொருட்டு, என்னால் முறையாக செயல்படுத்தப்பட்ட, ரூ. "&#13;
    + "&lt;b>Rs." + params["approvedAmtInRupees"].value + "&lt;/b> "&#13;
    + "((ரூபாய் &lt;b>" + params["approvedAmtInWord"].value + "&lt;/b>) "&#13;
    + "எனும் தொகைக்கான "&#13;
    + "&lt;b>" + params["apiResDateTime"].value.split(" ")[0] + "&lt;/b> "&#13;
    + "தேதியிட்ட கடனுறுதிப் பத்திரத்தின் டெலிவரியை பெற்றுக்கொள்ளுமாறு கிரெடிட் ஆக்சஸ் கிராமீன் லிமிட்டெட் (இனிமேல் சிஏஜிஎல் என அழைக்கப்படுகிறது), "&#13;
    + "&lt;b>" + params["branchName"].value + "&lt;/b> கிளையை கேட்டுக்கொள்கிறேன். கடன் தொகையை "&#13;
    + "&lt;b>" + params["term"].value + "&lt;/b> சமமான &lt;b>"&#13;
    + (&#13;
    params["paymentFreq"].value == "BI-WEEKLY" ? "2-weekly" :&#13;
    params["paymentFreq"].value == "FOUR-WEEKLY" ? "4-weekly" :&#13;
    params["paymentFreq"].value&#13;
  ) + "&lt;/b> தவணைகளில் வட்டியுடன் திருப்பிச் செலுத்த நான் இதன்மூலம் உறுதியளிக்கிறேன். நான் சிஏஜிஎல் கூட்டு பொறுப்புக் குழுவின் உறுப்பினராக கடன் தொகையை வாங்கியுள்ளேன் என்பதை இதன்மூலம் உறுதிப்படுத்துகிறேன். சிஏஜிஎல் ஊழியர்கள் விவரித்தபடி, கடன் தொகை, வட்டி விகிதம், தவணைத் தொகை மற்றும் திருப்பிச் செலுத்தும் கால அட்டவணை குறித்த எனது உரிமைகள் மற்றும் பொறுப்புகளை நான் முழுமையாக புரிந்து கொண்டேன் என்பதையும், மேலும் அவர்கள் கடன் பற்றிய விவரங்கள் அனைத்தையும் எனக்கு முழு திருப்தி ஏற்படும் அளவுக்கு தெளிவுபடுத்தினர் என்பதையும் நான் உறுதிப்படுத்துகிறேன். எனவே, ஒப்புக் கொள்ளப்பட்ட கால அட்டவணையின்படி கடன் தொகை மற்றும்/அல்லது வட்டியை செலுத்த குழுவின் மற்ற உறுப்பினர்களுடன் நான் தனியாகவும் கூட்டாகவும் பொறுப்பேற்க வேண்டும், மேலும் சிஏஜிஎல் நிறுவனம் அவர்களின் நிலுவைத் தொகைகளை மீட்பதற்காக கூட்டாகவோ மற்றும்/அல்லது தனியாகவோ எங்களுக்கு எதிராக பொருத்தமான சட்டரீதியான நடவடிக்கையை எடுக்கலாம். கடனை தவறாகப் பயன்படுத்துதல் அல்லது ஏதேனும் கடன் நிபந்தனைகளை மீறுதல் போன்ற நிகழ்வுகளில், சிஏஜிஎல் நிறுவனம் தன் விருப்பப்படி கடன் நிலுவையில் இருக்கும்போதே திரும்ப பெற்றுக்கொள்ள (இரத்து செய்ய) உரிமை உண்டு. மேலும் மேற்சொன்ன கடனுறுதிச் சீட்டை நான் செயல்படுத்தியுள்ளேன் என்பதையும், இந்த அறிவிப்பை நான் நல்ல மனதுடனும் ஆரோக்கியத்துடனும் இருக்கும்போது வெளியிட்டேன் மேலும், இந்த தேதியில் நான் எந்தவொரு தீவிர நோயாலும் பாதிக்கப்படவில்லை என்பதையும் நான் அறிவிக்கிறேன்.";&#13;
&#13;
}</expression>
                        <property name="contentType">html</property>
                    </text-data>
                    <text id="912819">
                        <property name="fontSize">7pt</property>
                        <property name="paddingTop">0pt</property>
                        <property name="paddingBottom">0pt</property>
                        <property name="textAlign">justify</property>
                        <property name="contentType">html</property>
                        <text-property name="content"><![CDATA[மேற்கொண்டு என்னை பரிந்துரை செய்யாமல் எந்தவொரு வங்கி/நிதி நிறுவனத்திற்கும் கடன்களை அடமானம் வைக்க, விற்க, ஒதுக்க, பத்திரமயமாக்க அல்லது அப்புறப்படுத்த சிஏஜிஎல் நிறுவனத்திற்கு இதன்மூலம் நான் அதிகாரம் அளிக்கிறேன். மேற்கூறிய குழுக் காப்பீட்டுத் திட்டத்தின் விதிமுறைகள் மற்றும் நிபந்தனைகளை முழுமையாகப் புரிந்து கொண்ட பிறகு, சிஏஜிஎல் ஆல் மாஸ்டர் பாலிசி ஹோல்டராக (MPH) நிர்வகிக்கப்படும் குழுக் காப்பீட்டுத் திட்டத்தின் கீழ் பதிவுசெய்ய நான் தானாக முன் வந்து என்னை அல்லது துணைவரை பதிவு செய்துள்ளேன் ஏதேனும் அசம்பாவிதம் ஏற்பட்டால், சிஏஜிஎல்-ன் பெயரில், நிலுவையில் உள்ள கடன்களின் அளவிற்கு, ஏதேனும் எதிர்பாராத நிகழ்வு மீதான உரிமைகோரல் தொகையைப் பிரித்து செலுத்துவதைத் தொடங்குவதற்கு காப்பீட்டு நிறுவனத்தை அனுமதிக்க நான் தானாக முன்வந்து என்னை அல்லது கணவன்/ இணைக் கடன் வாங்குபவர் பதிவு செய்துள்ளேன். மேலும் மீதமிருக்கும் நிலுவையிலுள்ள உரிமைகோரல்களின் தொகை நியமனதாரரின் பெயரில் வழங்கப்படலாம். அனைத்து தொழில் சங்கங்கள், கிரெடிட் பீரோ, நிறுவனத்திற்கு பணம் வழங்குபவர், ஏதேனும் சட்டப்பூர்வ, ஒழுங்குமுறை மற்றும் மதிப்பீட்டு நிறுவனத்திடம் எனது தனிப்பட்ட மற்றும் கடன் தொடர்பான தகவல்களை வெளியிட நான் தானாக முன்வந்து சிஏஎஜிஎல்-க்கு அனுமதியளிக்கின்றேன். மேலும் அவர்கள் மேலே குறிப்பிட்டுள்ள தரவு மற்றும் தகவல்களை ஒழுங்குமுறை மற்றும் இணக்கம் தொடர்பான தேவைகளை பூர்த்தி செய்யும் வகையில் பயன்படுத்தலாம். எனது அடையாளம் / முகவரிச் சான்றை உறுதிப்படுத்துவதற்காக சிஏஜிஎல் நிறுவனத்துக்கு எனது KYC நகலை எனது சொந்த விருப்பத்தின் பேரில் நான் தானாக முன்வந்து சிஏஜிஎல்-க்கு சமர்ப்பிக்கிறேன். இத்துடன் சமர்ப்பிக்கப்பட்ட எனது KYC மேலே குறிப்பிடப்பட்ட நோக்கம் அல்லது சட்டத்தின் தேவைகளின்படி மட்டுமே பயன்படுத்தப்படும் மற்றும் வேறு எந்த நோக்கத்திற்காகவும் பயன்படுத்தப்படாது என்று சிஏஜிஎல் எனக்கு தெரிவித்துள்ளது. எனது புகைப்படம், பெயர், கதை மற்றும் ஜிபிஎஸ் இருப்பிடம் ஆகியவை இணையதளங்கள் மற்றும் பிற ஊடகங்களால் சந்தைப்படுத்துதல் நோக்கங்களுக்காகவும் மற்றும் சிஏஜிஎல்-ன் வருடாந்திர அறிக்கைகள், சந்தைப்படுத்தல் மற்றும் பயிற்சி கையேடுகள், உள் அல்லது வெளிப்புற நோக்கங்களு க்கான நிகழ்வு ஆய்வுகள், மூன்றாம் தரப்பு ஆலோசகரின் அச்சு வெளியீடுகள் மற்றும்/அல்லது ஆடியோ வீடியோ நிகழ்ச்சிகள் ஆகியவற்றில் பயன்படுத்துவதற்காகவும் வெளியிடுவதற்கு இதன்மூலம் அனுமதிக்கிறேன்.  எனது தொலைபேசியில் சி.ஏ.ஜி.எல்-இடமிருந்து அனைத்து வகையான தகவல்தொடர்புகளையும் பெறுவதற்கு நான் ஒப்புதல் தெரிவிக்கிறேன்.
]]></text-property>
                    </text>
