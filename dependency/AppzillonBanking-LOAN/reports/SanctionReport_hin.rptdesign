                <cell id="222">
                    <text id="288">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[ऋण की राशि को भुगतान अवधि और आवृत्ति के अनुसार ब्याज सहित किश्तों में अदा करना होगा।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="223">
                <property name="height">0.2916666666666667in</property>
                <cell id="224">
                    <text id="272">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[2.]]></text-property>
                    </text>
                </cell>
                <cell id="225">
                    <text id="289">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[सीएजीएल के पास उधारकर्ता को सुझाव देने के अंतर्गत समय-समय पर ब्याज दर को रीसेट करने का विशेषाधिकार होगा, तथा उधारकर्ता इस प्रकार की गई संशोधित ब्याज दर का भावी भुगतान करने का वचन देती है]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="226">
                <property name="height">0.25in</property>
                <cell id="227">
                    <text id="273">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[3.]]></text-property>
                    </text>
                </cell>
                <cell id="228">
                    <text-data id="912581">
                        <property name="fontSize">9pt</property>
                        <expression name="valueExpr">if (&#13;
    params["pdtName"].value == "GL.IGL.VISH.LN" &#13;
    || params["pdtName"].value == "GL.GRM.VISH.SUPPL" &#13;
    || params["customerType"].value == "IL"&#13;
) {&#13;
    "ऋण राशि का वितरण क्रेडिट एक्सेस ग्रामीण लिमिटेड  (सीएजीएल) की एक व्यक्तिगत सदस्य के रूप में किया जाएगा।";&#13;
} else {&#13;
    "ऋण की राशि का भुगतान क्रेडिट एक्सेस ग्रामीण लिमिटेड ( इसके बाद इसे सीएजीएल कहा गया है) के संयुक्त देयता समूह के सदस्य के रूप में किया जाएगा";&#13;
}</expression>
                        <property name="contentType">html</property>
                    </text-data>
                </cell>
            </row>
            <row id="91186">
                <property name="height">0.25in</property>
                <cell id="91187">
                    <text id="91189">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[4.]]></text-property>
                    </text>
                </cell>
                <cell id="91188">
                    <text-data id="912582">
                        <property name="fontSize">9pt</property>
                        <expression name="valueExpr">if (&#13;
    params["pdtName"].value == "GL.IGL.VISH.LN" &#13;
    || params["pdtName"].value == "GL.GRM.VISH.SUPPL" &#13;
    || params["customerType"].value == "IL"&#13;
) {&#13;
    "ग्राहक को सभी केंद्र बैठकों में उपस्थित होना होगा, ऋण का उपयोग केवल सहमत उद्देश्य के लिए करना होगा, ऋण की किश्तों का समय पर भुगतान करना होगा तथा अपनी पुनर्भुगतान क्षमता से अधिक ऋण नहीं लेना होगा।";&#13;
} else {&#13;
    "ग्राहक को सभी केंद्र बैठकों में भाग लेना पड़ेगा, केवल सहमत उद्देश्य के लिए ऋण का उपयोग करना होगा, ऋण के किश्तों का भुगतान तुरंत करना होगा. केंद्र सदस्यों की सहायता करनी होगा यदि उन्हें किसी भी समस्या का सामना करना पड़ता है, और चुकाने की क्षमता से परे ऋण नहीं लेना चाहिए।";&#13;
}</expression>
                        <property name="contentType">html</property>
                    </text-data>
                </cell>
            </row>
            <row id="229">
                <property name="height">0.2708333333333333in</property>
                <cell id="230">
