                                <text id="91341">
                                    <property name="fontSize">7pt</property>
                                    <property name="marginTop">4pt</property>
                                    <property name="textAlign">justify</property>
                                    <property name="contentType">html</property>
                                    <text-property name="content"><![CDATA[എനിക്ക് വേണ്ടി സേവന അഭ്യർത്ഥനകൾ സമർപ്പിക്കാൻ ഞാൻ/ഞങ്ങൾ ക്രെഡിറ്റ്അക്സസ് ഗ്രാമീൺ ലിമിറ്റഡിനെ ഇതിനാൽ അധികാരപ്പെടുത്തുന്നു. ഇനിപ്പറയുന്ന ലൈഫ് ഇൻഷുറൻസ് കമ്പനികളുടെ മാസ്റ്റർ പോളിസി ഉടമ ക്രെഡിറ്റ്അക്സസ് ഗ്രാമീൺ ലിമിറ്റഡ് ആണെന്ന് എനിക്ക്/ഞങ്ങൾക്ക് അറിയാം.]]></text-property>
                                </text>
