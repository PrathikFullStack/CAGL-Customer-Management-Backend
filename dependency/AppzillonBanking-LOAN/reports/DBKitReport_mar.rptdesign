                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">preCloserLoanId6</property>
                    <expression name="expression" type="javascript">params["preCloserLoanId6"] == null ? "" : params["preCloserLoanId6"]</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">preCloserLoanId7</property>
                    <expression name="expression" type="javascript">params["preCloserLoanId7"] == null ? "" : params["preCloserLoanId7"]</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">preCloserLoanId8</property>
                    <expression name="expression" type="javascript">params["preCloserLoanId8"] == null ? "" : params["preCloserLoanId8"]</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount0</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount0"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount0"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount1</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount1"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount1"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount2</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount2"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount2"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount3</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount3"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount3"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount4</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount4"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount4"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount5</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount5"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount5"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount6</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount6"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount6"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount7</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount7"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount7"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">payoffAmount8</property>
                    <expression name="expression" type="javascript">(parseFloat(params["payoffAmount8"]) || 0) == 0&#13;
    ? ""&#13;
    : "Rs." + parseFloat(params["payoffAmount8"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">totalOutstandingAmount</property>
                    <expression name="expression" type="javascript">"Rs." + Math.round((&#13;
    (parseFloat(params["payoffAmount0"].value) || 0) +&#13;
    (parseFloat(params["payoffAmount1"].value) || 0) +&#13;
    (parseFloat(params["payoffAmount2"].value) || 0) +&#13;
    (parseFloat(params["payoffAmount3"].value) || 0) +&#13;
    (parseFloat(params["payoffAmount4"].value) || 0) +&#13;
    (parseFloat(params["payoffAmount5"].value) || 0) +&#13;
    (parseFloat(params["payoffAmount6"].value) || 0) +&#13;
    (parseFloat(params["payoffAmount7"].value) || 0) +&#13;
    (parseFloat(params["payoffAmount8"].value) || 0)&#13;
))</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">customerType</property>
                    <expression name="expression" type="javascript">(&#13;
    params["pdtName"].value == "GL.IGL.VISH.LN" &#13;
    || params["pdtName"].value == "GL.GRM.VISH.SUPPL" &#13;
    || params["customerType"].value == "IL"&#13;
) ? "IL" : "GL"</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">interestCharges</property>
                    <expression name="expression" type="javascript">"Rs."+params["interestCharges"]</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">disbursementDate</property>
                    <expression name="expression" type="javascript">params["apiResDateTime"].split(" ")[0]</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">disbursementAmount</property>
                    <expression name="expression" type="javascript">"Rs." + Math.round((&#13;
    (&#13;
        parseFloat(params["approvedAmtInRupees"].value) || 0&#13;
    ) -&#13;
    (&#13;
        (&#13;
            (parseFloat(params["processingFee"].value) || 0) +&#13;
            (parseFloat(params["insurancePremium"].value) || 0)&#13;
        ) +&#13;
        parseFloat(row["totalOutstandingAmount"].replace("Rs.",""))&#13;
    )&#13;
))</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">bankAccName</property>
                    <expression name="expression" type="javascript">params["bankAccName"]</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
            </list-property>
            <column id="256">
