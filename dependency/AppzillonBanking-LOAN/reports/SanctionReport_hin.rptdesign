                        <expression name="valueExpr">if (&#13;
    params["pdtName"].value == "GL.IGL.VISH.LN" &#13;
    || params["pdtName"].value == "GL.GRM.VISH.SUPPL" &#13;
    || params["customerType"].value == "IL"&#13;
) {&#13;
    "ग्राहक सहमत अनुसूची के अनुसार ऋण राशि और/या ब्याज का भुगतान करने के लिए उत्तरदायी होगी। ";&#13;
} else {&#13;
    "ग्राहक समूह के अन्य सदस्यों के साथ सहमति के अनुसार ऋण राशि और / या ब्याज का भुगतान करने के लिए व्यक्तिगत रूप से और संयुक्त रूप से उत्तरदायी होगी।";&#13;
}</expression>
                        <property name="contentType">html</property>
                    </text-data>
                </cell>
            </row>
            <row id="232">
                <cell id="233">
                    <text id="275">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[6.]]></text-property>
                    </text>
                </cell>
                <cell id="234">
                    <text id="293">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[ऋण के गलत तरीके से या किसी भी ऋण स्थितियों के उल्लंघन की स्थिति में सीएजीएल को ऋण को वापस लेने का अधिकार है।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="235">
                <cell id="236">
                    <text id="276">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[7.]]></text-property>
                    </text>
                </cell>
                <cell id="237">
                    <text id="294">
                        <property name="fontSize">9pt</property>
                        <property name="fontWeight">normal</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[सीएजीएल आश्वासन देता है कि उधारकर्ता डेटा की गोपनीयता का सम्मान किया जाएगा। सभी ऋण क्रेडिट ब्यूरो की जांच के अधीन होंगे और इसी कारण से डेटा क्रेडिट ब्यूरो एजेंसियों के साथ साझा किया जाएगा।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="238">
                <cell id="239">
                    <text id="277">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[8.]]></text-property>
                    </text>
                </cell>
                <cell id="240">
                    <text id="295">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[ऋण या किश्त के समय से पहले बंद करने या आंशिक भुगतान के लिए कोई शुल्क नहीं लगाया जाता है ।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="241">
                <cell id="242">
                    <text id="278">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[9.]]></text-property>
                    </text>
                </cell>
                <cell id="243">
                    <text id="296">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[प्रत्येक ऋण पर एक किश्त (केवल मूलधन) का मोराटोरियम प्रदान किया जाएगा।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="244">
                <cell id="245">
                    <text id="279">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[10.]]></text-property>
                    </text>
                </cell>
                <cell id="246">
                    <text id="297">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[ऋण का अनुदान सीएजीएल या तृतीय पक्ष द्वारा दी जाने वाली किसी अन्य उत्पाद / सेवाओं से जुड़ा नहीं है।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="247">
                <cell id="248">
                    <text id="280">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[11.]]></text-property>
                    </text>
                </cell>
                <cell id="249">
                    <text id="298">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[सीएजीएल किसी भी कर्मचारियों के अनुचित व्यवहार को रोकने और समय पर शिकायत निवारण सुनिश्चित करने के लिए उत्तरदायी है।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="250">
                <cell id="251">
                    <text id="281">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[12.]]></text-property>
                    </text>
                </cell>
                <cell id="252">
                    <text id="299">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[सीएजीएल ऋण के एवज में या ऋण के बदले में सुरक्षा जमा राशि या मार्जिन राशि एकत्र नहीं करेगा ।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="253">
                <cell id="254">
                    <text id="282">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[13.]]></text-property>
                    </text>
                </cell>
                <cell id="255">
                    <text id="300">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[यदि आवेदन की तिथि से 15 दिनों के भीतर ऋण वितरित नहीं किया जाता है, तो सीएजीएल सीबी स्थिति की पुनः जाँच कर सकता है।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="256">
                <cell id="257">
                    <text id="283">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[14.]]></text-property>
                    </text>
                </cell>
                <cell id="258">
                    <text id="301">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[ब्याज की गणना घटती शेष राशि पर ग्राहक द्वारा चुने गए भुगतान अवधि के अनुसार साप्ताहिक / द्विसाप्ताहिक / चार साप्ताहिक विकल्प पर की जाएगी।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="259">
                <cell id="260">
                    <text id="284">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[15.]]></text-property>
                    </text>
                </cell>
                <cell id="261">
                    <text id="302">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[ऋण किस्त की अदायगी की नियत तिथि, आवृत्ति तथा मूलधन और ब्याज का विवरण ऋण पासबुक में दिया जाएगा।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="262">
                <cell id="263">
                    <text id="285">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[16.]]></text-property>
                    </text>
                </cell>
                <cell id="264">
                    <text id="303">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[ऋण की कीमत से संबंधित की फैक्ट स्टेटमेंट इस स्वीकृति पत्र के साथ प्रदान किया गया है।]]></text-property>
                    </text>
                </cell>
            </row>
            <row id="265">
                <cell id="266">
                    <text id="286">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[17.]]></text-property>
                    </text>
                </cell>
                <cell id="267">
                    <text id="304">
                        <property name="fontSize">9pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[यदि ऋण खाता डिफॉल्ट में रहता है, तो ऐसे खाते को क्रेडिट ब्यूरो को रिपोर्ट किया जाएगा।]]></text-property>
                    </text>
                </cell>
            </row>
        </grid>
        <text id="307">
            <property name="fontSize">8pt</property>
            <property name="fontWeight">bold</property>
            <property name="marginTop">1pt</property>
