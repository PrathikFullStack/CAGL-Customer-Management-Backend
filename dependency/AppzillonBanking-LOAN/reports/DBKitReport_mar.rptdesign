                    <text-data id="912921">
                        <property name="fontSize">8pt</property>
                        <expression name="valueExpr">"मला समजले आहे की मला लागू शुल्क वजा केल्यानंतर आणि माझ्या विनंतीनुसार विद्यमान कर्जाची पूर्व-समाप्ती केल्यानंतर, बँक हस्तांतरणाद्वारे रुपये  &lt;B>Rs." +&#13;
parseInt(row["disbursementAmount"].replace("Rs.","").replace(/,/g,"")) +&#13;
"&lt;B>(रुपये"  + numberToWords(parseInt(row["disbursementAmount"].replace("Rs.","").replace(/,/g,""))) + ")&lt;/B> इतकी रक्कम मला प्राप्त होईल."</expression>
                        <property name="contentType">html</property>
