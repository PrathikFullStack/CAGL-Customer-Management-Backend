                    <text-data id="912831">
                        <property name="fontSize">7pt</property>
                        <expression name="valueExpr">"താഴെ പറയുന്ന എന്റെ അഭ്യർത്ഥനപ്രകാരം നിലവിലുള്ള ലോണുകൾ മുൻകൂട്ടി ക്ലോസ് ചെയ്യുന്നതിന്റെ ചാർജുകളും ബാധകമായ മറ്റു ചാർജുകളും കുറച്ച ശേഷം, ബാങ്ക് ട്രാൻസ്ഫർ വഴി   &lt;B>Rs."+parseInt(row["disbursementAmount"].replace("Rs.","").replace(/,/g,""))+"&lt;/B>  &lt;B>("+numberToWords(parseInt(row["disbursementAmount"].replace("Rs.","").replace(/,/g,"")))+"രൂപ)&lt;/B> എനിക്ക് ലഭിക്കുമെന്ന് ഞാൻ മനസ്സിലാക്കുന്നു."</expression>
                        <property name="contentType">html</property>
                    </text-data>
