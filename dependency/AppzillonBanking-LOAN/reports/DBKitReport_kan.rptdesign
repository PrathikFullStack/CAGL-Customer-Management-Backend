                                    <property name="fontFamily">serif</property>
                                    <property name="fontSize">7pt</property>
                                    <property name="paddingTop">0pt</property>
                                    <property name="paddingBottom">0pt</property>
                                    <property name="paddingRight">0pt</property>
                                    <property name="contentType">html</property>
                                    <text-property name="content"><![CDATA[ಬೇಡಿಕೆಯ ಮೇರೆಗೆ ನಾನು <U><B><VALUE-OF>params["memberName"]</VALUE-OF></B></U> , <U><B><VALUE-OF>params["depname"]</VALUE-OF></B></U> ಅವರ ಪತ್ನಿ/ಪುತ್ರಿ  ಆಗಿದ್ದು <B><VALUE-OF>params["fullAddress"]</VALUE-OF></B> ರಲ್ಲಿ  ವಾಸಿಸುತ್ತಿದ್ದು, ರೂ. <B>Rs.<VALUE-OF>params["approvedAmtInRupees"]</VALUE-OF></B> (ಮೊತ್ತ ಅಕ್ಷರಗಳಲ್ಲಿ ರೂಪಾಯಿಗಳು <B><VALUE-OF>params["approvedAmtInWord"]</VALUE-OF></B>) ಮೊತ್ತದ ಹಣವನ್ನು ಸ್ವೀಕರಿಸಲಾದ ಮೌಲ್ಯಕ್ಕೆ ಇಳಿಕೆ ಮೊತ್ತದ ಮೇಲೆ <B><VALUE-OF>params["interestRate"]</VALUE-OF>%</B> ವಾರ್ಷಿಕ ಬಡ್ಡಿಯಲ್ಲಿ ಸಿಎಜಿಎಲ್ ನ <B><VALUE-OF>params["branchName"]</VALUE-OF></B> ಶಾಖೆ ಅಥವಾ ಆರ್ಡರ್‌ಗೆ ಪಾವತಿಸುವುದಾಗಿ ಭರವಸೆ ನೀಡುತ್ತೇನೆ.]]></text-property>
                                </text>
                                <grid id="179">
                                    <property name="marginTop">2pt</property>
                                    <property name="width">5.958333333333333in</property>
                                    <column id="180">
                                        <property name="width">0.8541666666666666in</property>
                                    </column>
                                    <column id="181">
                                        <property name="width">2.2291666666666665in</property>
                                    </column>
