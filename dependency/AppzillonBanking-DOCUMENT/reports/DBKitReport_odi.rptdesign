                                    <property name="paddingBottom">0pt</property>
                                    <property name="textAlign">justify</property>
                                    <property name="contentType">auto</property>
                                    <text-property name="content"><![CDATA[ମୁଁ, ଏହାଦ୍ୱାରା, ନିଶ୍ଚିତ କରୁଛି ଯେ ପ୍ରଦାନ କରାଯାଇଥିବା ଋଣ ସିଏଜିଏଲ୍‌ ର ଇଏସ୍ଏମ୍ଏସ୍ ନୀତି ଅନୁଯାୟୀ ଅଛି।]]></text-property>
                                </text>
