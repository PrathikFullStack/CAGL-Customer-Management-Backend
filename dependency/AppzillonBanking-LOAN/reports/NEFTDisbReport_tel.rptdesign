                                    <property name="contentType">auto</property>
                                    <text-property name="content"><![CDATA[క్రెడిట్ఆక్సెస్ గ్రామీణ్ లిమిటెడ్]]></text-property>
                                </text>
                                <text id="11">
                                    <property name="fontSize">8pt</property>
                                    <property name="color">#808080</property>
                                    <property name="textAlign">center</property>
                                    <property name="whiteSpace">normal</property>
                                    <property name="display">block</property>
                                    <property name="contentType">auto</property>
                                    <text-property name="content"><![CDATA[ (గతంలో గ్రామీణ్ కూట ఫైనాన్షియల్ సర్వీసెస్ ప్రైవేట్ లిమిటెడ్ అని పిలుస్తారు)]]></text-property>
                                </text>
                                <text id="12">
                                    <property name="fontSize">8pt</property>
                                    <property name="textAlign">center</property>
                                    <property name="whiteSpace">normal</property>
                                    <property name="display">block</property>
                                    <property name="contentType">auto</property>
