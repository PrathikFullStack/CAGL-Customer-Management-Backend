                    <text-data id="912762">
                        <property name="fontFamily">serif</property>
                        <property name="fontSize">7pt</property>
                        <property name="marginTop">1pt</property>
                        <property name="marginBottom">2pt</property>
                        <property name="paddingBottom">0pt</property>
                        <list-property name="visibility">
                            <structure>
                                <property name="format">all</property>
                                <expression name="valueExpr" type="javascript">params["insurancePremium"].value == 0</expression>
                            </structure>
                        </list-property>
                        <expression name="valueExpr">"ಅನ್ವಯಿಸುವ ಶುಲ್ಕಗಳನ್ನು ಕಡಿತಗೊಳಿಸಿದ ಬಳಿಕ ಹಾಗೂ ನಾನು ಕೆಳಗೆ ವಿನಂತಿಸಿರುವ ಪ್ರಕಾರ ಚಾಲ್ತಿಯಲ್ಲಿರುವ ಸಾಲಗಳನ್ನು ಅವಧಿ ಪೂರ್ವ ಮುಚ್ಚಿದ ಬಳಿಕ ಉಳಿದಿರುವ ರೂ. &lt;B>Rs."+ parseFloat(row["disbursementAmount"].replace("Rs.","").replace(/,/g,""))+"&lt;/B> &lt;B>(ರೂಪಾಯಿಗಳು " +numberToWords(parseFloat(row["disbursementAmount"].replace("Rs.","").replace(/,/g,"")))+")&lt;/B> ಗಳನ್ನು ನನ್ನ ಬ್ಯಾಂಕ್ ಖಾತೆಗೆ ಆನ್‌ಲೈನ್ ಮೂಲಕ ವರ್ಗಾಯಿಸಲಾಗುತ್ತದೆ ಎಂದು ನಾನು ಅರ್ಥ ಮಾಡಿಕೊಂಡಿದ್ದೇನೆ:"</expression>
                        <property name="contentType">html</property>
                    </text-data>
