                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">preCloserLoanId0</property>
                    <expression name="expression" type="javascript">params["preCloserLoanId0"] == null ? "" : params["preCloserLoanId0"]</expression>
                    <property name="dataType">string</property>
