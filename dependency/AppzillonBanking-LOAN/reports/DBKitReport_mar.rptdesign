                    <text id="382">
                        <property name="fontFamily">serif</property>
                        <property name="fontSize">8pt</property>
                        <property name="marginTop">1pt</property>
                        <property name="marginBottom">1pt</property>
                        <property name="textAlign">justify</property>
                        <property name="contentType">html</property>
                        <text-property name="content"><![CDATA[मी / आम्ही याची पुढील पुष्टी करते/करतो की मी / आम्ही नमूद केलेल्या गटधारक पॉलिसीचे सदस्य आहोत आणि वरीलप्रमाणे माझ्या / आमच्या निवडीच्या विमा कंपनीकडून ______________________ अंतर्गत जीवन विमा संरक्षण घेण्यास संमती देतो/देतो. तसेच मी / आम्ही याचीही पुष्टी करते/करतो की लागू होणारी विमा प्रीमियम रक्कम माझ्या / आमच्या कर्ज खात्यातून भरली गेली आहे. मला/आम्ही या गट धोरणाची वैशिष्ट्ये समजली आहे आणि अटी व शर्तींशी मी सहमत आहे.]]></text-property>
                    </text>
                    <text id="385">
                        <property name="fontFamily">serif</property>
                        <property name="fontSize">8pt</property>
                        <property name="marginTop">1pt</property>
                        <property name="marginBottom">1pt</property>
                        <property name="paddingBottom">2pt</property>
                        <property name="contentType">html</property>
                        <text-property name="content"><![CDATA[आपण आपले कर्ज पूर्ववत केल्यानंतर किंवा आपले कर्ज दुसऱ्या वित्तीय संस्थेकडे हस्तांतरित केल्यानंतर देखील कव्हरेज मुदतीपर्यंत आपले कव्हर चालू ठेवू इच्छिता, किंवा आपण स्वेच्छेने ग्रुप मेंबरशिप सरेंडर कराल?  <span style="border:1px solid black; padding:3px;">&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;</span>होय	 <span style="border:1px solid black; padding:3px;">&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;</span>नाही
<Br></Br>]]></text-property>
                    </text>
