                    <text id="191">
                        <property name="fontFamily">serif</property>
                        <property name="fontSize">9pt</property>
                        <property name="fontWeight">bold</property>
                        <property name="textUnderline">underline</property>
                        <property name="marginTop">5pt</property>
                        <property name="marginBottom">5pt</property>
                        <property name="paddingTop">0pt</property>
                        <property name="paddingBottom">0pt</property>
                        <property name="textAlign">left</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[ସଦସ୍ୟ ଘୋଷଣା:]]></text-property>
                    </text>
                    <text-data id="912829">
                        <property name="fontSize">8pt</property>
                        <expression name="valueExpr">if (&#13;
    params["pdtName"].value == "GL.IGL.VISH.LN" &#13;
    || params["pdtName"].value == "GL.GRM.VISH.SUPPL" &#13;
    || params["customerType"].value == "IL"&#13;
) {&#13;
&#13;
    "ମୁଁ କ୍ରେଡିଟ୍ ଆକ୍ସେସ ଗ୍ରାମୀଣ ଲିମିଟେଡ (ଏଠାରେ ପରେ ସିଏଜିଏଲ୍‌ ନାମରେ ପରିଚିତ),"&#13;
    &#13;
    + "&lt;b>" + params["branchName"].value + "&lt;/b>  ଶାଖାକୁ ଅନୁରୋଧ କରୁଛି ଯେ ମୋ ଦ୍ୱାରା ଯଥାସମ୍ଭବ ଭାବରେ ସମ୍ପାଦିତ ହୋଇଥିବା ପ୍ରମିଜୋରି ନୋଟ୍  "&#13;
    + "&lt;b>" + params["apiResDateTime"].value.split(" ")[0] + "&lt;/b>  ଟଙ୍କା"&#13;
    + "&lt;b>Rs." + params["approvedAmtInRupees"].value + "&lt;/b>"&#13;
    + "((ଟଙ୍କ &lt;b>" + params["approvedAmtInWord"].value + "&lt;/b>) ଗ୍ରହଣ କରନ୍ତୁ, ଯାହା ପାଇଁ ମୁଁ ବିବେଚନା ପାଇଛି। ମୁଁ ଏତଦ୍ଦ୍ୱାରା ଋଣ ପରିମାଣ ସୁଧ ସହିତ  "&#13;
&#13;
    + params["term"].value + "&lt;/b> ସମାନ  &lt;b>" &#13;
    + params["paymentFreq"].value + "&lt;/b> କିସ୍ତିରେ ପରିଶୋଧ କରିବାକୁ ପ୍ରତିଶ୍ରୁତି ଦେଉଛି। ମୁଁ ଏହିଠାରେ ନିଶ୍ଚୟ କରୁଛି ଯେ, ମୁଁ ସିଏଜିଏଲର ଏକ ବ୍ୟକ୍ତିଗତ ସଦସ୍ୟା ଭାବେ ଋଣ ରାଶି ଉଧାର ନେଇଛି। ମୁଁ ପୁଣି ନିଶ୍ଚିତ କରୁଛି ଯେ ମୁଁ ସଂପୂର୍ଣ୍ଣ ଭାବରେ ଋଣ ପରିମାଣ, ସୁଧ ହାର, କିସ୍ତି ପରିମାଣ ଏବଂ ପରିଶୋଧ ସମୟ ସୂଚୀ ସଂପର୍କରେ ମୋର ଅଧିକାର ଏବଂ ଦାୟିତ୍ବ ବୁଝିଛି, ଯେପରି ଭାବରେ ସିଏଜିଏଲ୍‌ର କର୍ମଚାରୀଙ୍କ ଦ୍ବାରା ବୁଝାଇ ଦିଆଯାଇଛି ଏବଂ ସେମାନେ ମଧ୍ୟ ମୋର ସଂପୂର୍ଣ୍ଣ ସନ୍ତୋଷ ପର୍ଯ୍ୟନ୍ତ ଋଣ ସଂପର୍କରେ ସମସ୍ତ ବିବରଣୀ ସ୍ପଷ୍ଟ କରିଛନ୍ତି। ମୁଁ ନିର୍ଦ୍ଧାରିତ ସମୟସୂଚୀ ଅନୁଯାୟୀ ଋଣ ରାଶି ଏବଂ/କିମ୍ବା ସୁଧ ଦେବାକୁ ଦାୟୀ ହେବି, ଏବଂ ସିଏଜିଏଲ ତାଙ୍କର ବକାୟା ରାଶି ପାଇଁ ମୋ ବିରୁଦ୍ଧରେ ଯଥୋଚିତ କାନୁନୀ କାର୍ଯ୍ୟାନୁଷ୍ଠାନ କରିପାରନ୍ତି ।  ଋଣ ପରିମାଣର ଅନୁପଯୁକ୍ତ ଉପଯୋଗ ଘଟଣାରେ କିମ୍ବା କୌଣସି ଋଣ ସର୍ତ୍ତାବଳୀ ଉଲ୍ଲଙ୍ଘନ କ୍ଷେତ୍ରରେ ସିଏଜିଏଲ୍‌ର ସେମାନଙ୍କର ନିଜସ୍ବ ବିବେକ ଅନୁସାରେ ଏହି ଋଣ ଚାଲୁଥିବା ସମୟରେ ଏହାକୁ ଫେରସ୍ତ ନେବାର ଅଧିକାର ରହିଛି। ମୁଁ ପୁନଶ୍ଚ ଘୋଷଣା କରୁଛି ଯେ ମୁଁ ଉପରୋକ୍ତ ଋଣପତ୍ର କାର୍ଯ୍ୟକାରୀ କରିଛି ଏବଂ ମୁଁ ସୁସ୍ଥ ମସ୍ତିଷ୍କ ଏବଂ ସ୍ବାସ୍ଥ୍ୟରେ ଏହି ଘୋଷଣା କରିଛି ଏବଂ ଏହା ଯେ ମୁଁ ଏହି ତାରିଖ ସୁଦ୍ଧା କୌଣସି ଗୁରୁତର ରୋଗରେ ପୀଡ଼ିତ ନୁହେଁ। ";&#13;
&#13;
} else {&#13;
&#13;
    "ମୁଁ କ୍ରେଡିଟ୍ ଆକ୍ସେସ ଗ୍ରାମୀଣ ଲିମିଟେଡ (ଏଠାରେ ପରେ ସିଏଜିଏଲ୍‌ ନାମରେ ପରିଚିତ),"&#13;
    &#13;
    + "&lt;b>" + params["branchName"].value + "&lt;/b>  ଶାଖାକୁ ଅନୁରୋଧ କରୁଛି ଯେ ମୋ ଦ୍ୱାରା ଯଥାସମ୍ଭବ ଭାବରେ ସମ୍ପାଦିତ ହୋଇଥିବା ପ୍ରମିଜୋରି ନୋଟ୍  "&#13;
    + "&lt;b>" + params["apiResDateTime"].value.split(" ")[0] + "&lt;/b>  ଟଙ୍କା"&#13;
    + "&lt;b>Rs." + params["approvedAmtInRupees"].value + "&lt;/b>"&#13;
    + "((ଟଙ୍କ &lt;b>" + params["approvedAmtInWord"].value + "&lt;/b>) ଗ୍ରହଣ କରନ୍ତୁ, ଯାହା ପାଇଁ ମୁଁ ବିବେଚନା ପାଇଛି। ମୁଁ ଏତଦ୍ଦ୍ୱାରା ଋଣ ପରିମାଣ ସୁଧ ସହିତ "&#13;
&#13;
    + params["term"].value + "&lt;/b> ସମାନ  &lt;b>" &#13;
    + params["paymentFreq"].value + "&lt;/b> କିସ୍ତିରେ ପରିଶୋଧ କରିବାକୁ ପ୍ରତିଶ୍ରୁତି ଦେଉଛି। ମୁଁ ଏତଦ୍ ଦ୍ବାରା ନିଶ୍ଚିତ କରୁଛି ଯେ ମୁଁ ସିଏଜିଏଲ୍‌ର ମିଳିତ ଦାୟିତ୍ୱ ଗୋଷ୍ଠୀର ସଦସ୍ୟ ଭାବରେ ଋଣ  ପରିମାଣ ଉଧାର ନେଇଛି। ମୁଁ ପୁଣି ନିଶ୍ଚିତ କରୁଛି ଯେ ମୁଁ ସଂପୂର୍ଣ୍ଣ ଭାବରେ ଋଣ ପରିମାଣ, ସୁଧ ହାର, କିସ୍ତି ପରିମାଣ ଏବଂ ପରିଶୋଧ ସମୟ ସୂଚୀ ସଂପର୍କରେ ମୋର ଅଧିକାର ଏବଂ ଦାୟିତ୍ବ ବୁଝିଛି, ଯେପରି ଭାବରେ ସିଏଜିଏଲ୍‌ର କର୍ମଚାରୀଙ୍କ ଦ୍ବାରା ବୁଝାଇ ଦିଆଯାଇଛି ଏବଂ ସେମାନେ ମଧ୍ୟ ମୋର ସଂପୂର୍ଣ୍ଣ ସନ୍ତୋଷ ପର୍ଯ୍ୟନ୍ତ ଋଣ ସଂପର୍କରେ ସମସ୍ତ ବିବରଣୀ ସ୍ପଷ୍ଟ କରିଛନ୍ତି। ଏତଦ୍ ଦ୍ବାରା, ମୁଁ ବ୍ୟକ୍ତିଗତ ଭାବରେ ଏବଂ ମିଳିତ ଭାବରେ ଗୋଷ୍ଠୀ ଅନ୍ୟ ସଦସ୍ୟମାନଙ୍କ ସହିତ ସହମତି ପ୍ରକାଶ କରାଯାଇଥିବା ସମୟ ସୂଚୀ ଅନୁଯାୟୀ ଋଣ ପରିମାଣ ଏବଂ/କିମ୍ବା ସୁଧ ପୈଠ କରିବା ପାଇଁ ଉତ୍ତର ହେବି ଏବଂ ସିଏଜିଏଲ୍‌ ସେମାନଙ୍କର ବକେୟା ପରିମାଣ ଆଦାୟ କରିବା ନିମନ୍ତେ ଆମ ବିରୋଧରେ ମିଳିତ ଭାବରେ ଏବଂ/ କିମ୍ବା ବ୍ୟକ୍ତିଗତ ଭାବରେ ଉପଯୁକ୍ତ ଆଇନଗତ କାର୍ଯ୍ୟାନୁଷ୍ଠାନ ଆରମ୍ଭ କରିପାରିବେ। ଋଣ ପରିମାଣର ଅନୁପଯୁକ୍ତ ଉପଯୋଗ ଘଟଣାରେ କିମ୍ବା କୌଣସି ଋଣ ସର୍ତ୍ତାବଳୀ ଉଲ୍ଲଙ୍ଘନ କ୍ଷେତ୍ରରେ ସିଏଜିଏଲ୍‌ର ସେମାନଙ୍କର ନିଜସ୍ବ ବିବେକ ଅନୁସାରେ ଏହି ଋଣ ଚାଲୁଥିବା ସମୟରେ ଏହାକୁ ଫେରସ୍ତ ନେବାର ଅଧିକାର ରହିଛି। ମୁଁ ପୁନଶ୍ଚ ଘୋଷଣା କରୁଛି ଯେ ମୁଁ ଉପରୋକ୍ତ ଋଣପତ୍ର କାର୍ଯ୍ୟକାରୀ କରିଛି ଏବଂ ମୁଁ ସୁସ୍ଥ ମସ୍ତିଷ୍କ ଏବଂ ସ୍ବାସ୍ଥ୍ୟରେ ଏହି ଘୋଷଣା କରିଛି ଏବଂ ଏହା ଯେ ମୁଁ ଏହି ତାରିଖ ସୁଦ୍ଧା କୌଣସି ଗୁରୁତର ରୋଗରେ ପୀଡ଼ିତ ନୁହେଁ।";&#13;
&#13;
}</expression>
