            <text-property name="content"><![CDATA[# ब्याज दर की गणना घटती शेष राशि (ग्राहक द्वारा चुने गए पुनर्भुगतान अवधि के अनुसार साप्ताहिक/2 साप्ताहिक/4 साप्ताहिक शेष) पर की जाती है।]]></text-property>
        </text>
        <text id="117">
            <property name="fontSize">9pt</property>
            <property name="contentType">html</property>
            <text-property name="content"><![CDATA["सीएजीएल के साथ उधारकर्ता के संबंध और भौगोलिक क्रेडिट जोखिम मूल्यांकन के आधार पर ब्याज दर भिन्न हो सकती है"
आपको यह बताते हुए हमें प्रसन्नता है कि आपका ऋण आवेदन नीचे उल्लिखित निबंधन और शर्तों के अनुसार स्वीकृत किया गया है। यह स्वीकृति, स्वीकृति की तिथि से 4 सप्ताह की अवधि के लिए वैध है, जो सीबी रिपोर्ट के पुनः परीक्षण के अधीन है।]]></text-property>
        </text>
        <text id="912324">
            <property name="fontSize">8pt</property>
            <property name="fontWeight">bold</property>
            <property name="marginTop">2pt</property>
            <property name="contentType">auto</property>
            <text-property name="content"><![CDATA[ऋण राशि निम्नलिखित बैंक खाते में स्थानांतरित की जाएगी।]]></text-property>
        </text>
