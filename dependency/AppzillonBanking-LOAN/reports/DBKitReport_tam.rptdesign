                            <cell id="205">
                                <property name="verticalAlign">middle</property>
                                <text id="217">
                                    <property name="fontSize">7pt</property>
                                    <property name="contentType">auto</property>
                                    <text-property name="content"><![CDATA[பதிவு செய்யவில்லை. பதிவு செய்துள்ளது என்றால் ஜிஎஸ்டி எண்ணை வழங்கவும்………….]]></text-property>
                                </text>
                            </cell>
                        </row>
                    </grid>
                    <text-data id="912823">
                        <property name="fontSize">7pt</property>
                        <list-property name="visibility">
                            <structure>
                                <property name="format">all</property>
                                <expression name="valueExpr" type="javascript">params["insurancePremium"].value == 0</expression>
                            </structure>
                        </list-property>
                        <expression name="valueExpr">"எனது கோரிக்கையின்படி, பொருந்தக்கூடிய கட்டணங்களைக் கழித்துக்கொண்டு மற்றும் ஏற்கனவே உள்ள கடன்களை முன்கூட்டியே முடித்த பிறகு, வங்கிப் பரிமாற்றம் மூலம் பின்வருமாறு ரூ. &lt;B>Rs." +&#13;
parseInt(row["disbursementAmount"].replace("Rs.","").replace(/,/g,"")) +&#13;
"(ரூபாய்&lt;B>"  + numberToWords(parseInt(row["disbursementAmount"].replace("Rs.","").replace(/,/g,""))) + "&lt;/B> தொகையைப் பெறுவேன் என்பதை நான் புரிந்துகொண்டுள்ளேன்:"</expression>
                        <property name="contentType">html</property>
                    </text-data>
