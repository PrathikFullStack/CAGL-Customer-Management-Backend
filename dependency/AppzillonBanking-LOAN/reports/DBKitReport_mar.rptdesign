                    <text id="191">
                        <property name="fontFamily">serif</property>
                        <property name="fontSize">9pt</property>
                        <property name="fontWeight">bold</property>
                        <property name="textUnderline">underline</property>
                        <property name="marginTop">1pt</property>
                        <property name="marginBottom">1pt</property>
                        <property name="paddingBottom">0pt</property>
                        <property name="textAlign">left</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[सदस्याचे घोषणापत्रः ]]></text-property>
                    </text>
                    <text-data id="912918">
                        <property name="fontSize">8pt</property>
                        <expression name="valueExpr">if (&#13;
    params["pdtName"].value == "GL.IGL.VISH.LN" &#13;
    || params["pdtName"].value == "GL.GRM.VISH.SUPPL" &#13;
    || params["customerType"].value == "IL"&#13;
) {&#13;
&#13;
    "मी क्रेडिटॲक्सेस ग्रामीण लिमिटेड (यापुढे जे सीएजीएल म्हणून नमुद केलेले आहे),"&#13;
    &#13;
    + "&lt;b>" + params["branchName"].value + "&lt;/b> शाखेला विनंती करते की त्यांनी दिनांक "&#13;
    + "&lt;b>" + params["apiResDateTime"].value.split(" ")[0] + "&lt;/b>च्या दिनांकाची रु"&#13;
    + "&lt;b>Rs." + params["approvedAmtInRupees"].value + "&lt;/b> "&#13;
    + "((रुपये&lt;b>" + params["approvedAmtInWord"].value + "&lt;/b>) "&#13;
&#13;
    + "  ची हमीपत्रक माझ्याकडून विधिवतरीत्या अंमलात आणलेले स्वीकारावे, ज्यासाठी मला प्रत्यक्ष रक्कम प्राप्त झाली आहे. मी याद्वारे कर्जाची रक्कम "&#13;
    + params["term"].value + "&lt;/b>  मध्ये समान &lt;b>" &#13;
    + (&#13;
    params["paymentFreq"].value == "BI-WEEKLY" ? "2-weekly" :&#13;
    params["paymentFreq"].value == "FOUR-WEEKLY" ? "4-weekly" :&#13;
    params["paymentFreq"].value&#13;
  ) + "&lt;/b> हप्त्याने लागू असलेल्या व्याजासह भरण्याची जबाबदारी स्वीकारते.मी याद्वारे पुष्टी करते की मी सीएजीएल ची एक वैयक्तिक सदस्य म्हणून कर्जाची रक्कम उधार घेतली आहे. मी अधिक पुढे पुष्टी करत आहे कि मला कर्ज रक्कम, व्याजाचा दर, हप्त्याची रक्कम आणि परतफेडीचे वेळापत्रक, याविषयी माझे हक्क आणि जबाबदारीबद्दल जसे सीएजीएलच्या कर्मचाऱ्यांकडून स्पष्ट केले गेले आहे ते पूर्णपणे समजले आहे आणि त्यांनी कर्जाविषयी सर्व तपशीलसुद्धा माझे समाधान होईपर्यंत पूर्णपणे स्पष्ट केले आहेत. मी सहमत अनुसूचीप्रमाणे कर्जाची रक्कम आणि/किंवा व्याज भरण्यास जबाबदार असेल, आणि सीएजीएल आपल्या देय रकमेची वसूली करण्यासाठी माझ्याविरुद्ध योग्य कायदेशीर कारवाई सुरू करू शकते.. कर्जाचा दुरूपयोग झाल्यास किंवा कर्जाच्या कोणत्याही अटीचे उल्लघंन झाल्यास सीएजीएल त्यांच्या कार्य स्वातंत्र्यानुसार कर्ज प्रलंबित असण्याच्या कालावधीत कर्जाची परत मागणी करू शकते. मी अधिक पूढे घोषित करते की मी वरील वचनपत्र पूर्ण केली आहे आणि माझ्या उत्तम बौद्धिक व शारिरीक स्थितीमध्ये असताना हे घोषणापत्र केले आहे तसेच मी सध्या कोणत्याही गंभीर आजाराने ग्रस्त नाही.";&#13;
&#13;
} else {&#13;
&#13;
    "मी क्रेडिटॲक्सेस ग्रामीण लिमिटेड (यापुढे जे सीएजीएल म्हणून नमुद केलेले आहे),"&#13;
    &#13;
    + "&lt;b>" + params["branchName"].value + "&lt;/b> शाखेला विनंती करते की त्यांनी दिनांक  "&#13;
    + "&lt;b>" + params["apiResDateTime"].value.split(" ")[0] + "&lt;/b> च्या दिनांकाची रु "&#13;
    + "&lt;b>Rs." + params["approvedAmtInRupees"].value + "&lt;/b> "&#13;
    + "((रुपये&lt;b>" + params["approvedAmtInWord"].value + "&lt;/b>) "&#13;
&#13;
    + " ची हमीपत्रक माझ्याकडून विधिवतरीत्या अंमलात आणलेले स्वीकारावे, ज्यासाठी मला प्रत्यक्ष रक्कम प्राप्त झाली आहे. मी याद्वारे कर्जाची रक्कम "&#13;
    + params["term"].value + "&lt;/b>  मध्ये समान &lt;b>" &#13;
    + (&#13;
    params["paymentFreq"].value == "BI-WEEKLY" ? "2-weekly" :&#13;
    params["paymentFreq"].value == "FOUR-WEEKLY" ? "4-weekly" :&#13;
    params["paymentFreq"].value&#13;
  ) + "&lt;/b> हप्त्याने लागू असलेल्या व्याजासह भरण्याची जबाबदारी स्वीकारते. मी याद्वारे पुष्टी करत आहे की मी सीएजीएलच्या संयुक्त दायित्व गटाचा एक सदस्य म्हणून कर्जाची रक्कम उधार घेतली आहे. मी अधिक पुढे पुष्टी करत आहे कि मला कर्ज रक्कम, व्याजाचा दर, हप्त्याची रक्कम आणि परतफेडीचे वेळापत्रक, याविषयी माझे हक्क आणि जबाबदारीबद्दल जसे सीएजीएलच्या कर्मचाऱ्यांकडून स्पष्ट केले गेले आहे ते पूर्णपणे समजले आहे आणि त्यांनी कर्जाविषयी सर्व तपशीलसुद्धा माझे समाधान होईपर्यंत पूर्णपणे स्पष्ट केले आहेत. त्यामुळे मी कर्जाची रक्कम आणि/किंवा व्याज सहमती झालेल्या वेळापत्रकानुसार वैयक्तिकरित्या तसेच गटाच्या इतर सदस्यांसह संयुक्तपणे परतफेड करण्यास जबाबदार असेल आणि सीएजीएल त्यांची देय रक्कम वसूल करण्याकरिता आमच्याविरुद्ध संयुक्तपणे आणि/किंवा वैयक्तिकरित्या योग्य कायदेशीर कारवाई सुरू करू शकते. कर्जाचा दुरूपयोग झाल्यास किंवा कर्जाच्या कोणत्याही अटीचे उल्लघंन झाल्यास सीएजीएल त्यांच्या कार्य स्वातंत्र्यानुसार कर्ज प्रलंबित असण्याच्या कालावधीत कर्जाची परत मागणी करू शकते. मी अधिक पूढे घोषित करते की मी वरील वचनपत्र पूर्ण केली आहे आणि माझ्या उत्तम बौद्धिक व शारिरीक स्थितीमध्ये असताना हे घोषणापत्र केले आहे तसेच मी सध्या कोणत्याही गंभीर आजाराने ग्रस्त नाही.";&#13;
&#13;
}</expression>
                        <property name="contentType">html</property>
                    </text-data>
                    <text id="912917">
                        <property name="fontSize">7.5pt</property>
                        <property name="paddingBottom">0pt</property>
                        <property name="textAlign">justify</property>
                        <property name="contentType">html</property>
                        <text-property name="content"><![CDATA[मी येथे सीएजीएल ला मला पुढील कोणताही संदर्भ न देता कोणत्याही बँकेला/वित्तीय संस्थेला कर्जे तारण ठेवणे, विक्री करणे, हस्तांतरित करणे, हमी म्हणून वापरणे किंवा त्यांचा निकालात काढण्यास अधिकृत करते. या गट विमा योजनेच्या अटी व शर्ती पूर्णपणे समजून घेतल्यानंतर, मी स्वेच्छेने माझ्या स्वतःच्या आणि/किंवा माझ्या जोडीदाराच्या नावाने सीएजीएल द्वारे प्रशासित गट विमा योजनेअंतर्गत मास्टर पॉलिसी होल्डर (एमपीएच) म्हणून नोंदणी करण्याचा पर्याय निवडला आहे. कोणतीही घटना घडल्यास, मी याद्वारे विमा कंपनीला दाव्याच्या रकमेचे विभाजित पेमेंट करण्यासाठी माझी/आमची संमती देते/ देतो. यामध्ये, कोणतीही आकस्मिक घटना घडल्यास थकीत कर्जाच्या मर्यादेपर्यंतची रक्कम सीएजीएल च्या लाभार्थ जमा करण्यात येईल आणि दाव्यातील उर्वरित रक्कम त्यानुसार नामनिर्देशित व्यक्तीच्या नावाने जमा करण्यात येईल. मी स्वेच्छेने सीएजीएल ला माझी वैयक्तिक आणि क्रेडिटसंबंधी माहिती सर्व संबंधित औद्योगिक संस्था, क्रेडिट ब्युरो, कंपनीचे कर्जदाता, कोणतेही वैधानिक नियामक आणि रेटिंग एजन्सी यांना सादर करण्याची परवानगी देते, आणि ही माहिती नियामक व अनुपालनविषयक आवश्यकता पूर्ण करण्यासाठी योग्य पद्धतीने वापरली जाऊ शकते. मी याद्वारे स्वेच्छेने आणि माझ्या स्वतःच्या विवेकबुद्धीनुसार, माझी ओळख व पत्त्याचा पुरावा स्थापित करण्याच्या उद्देशाने माझ्या केवायसी कागदपत्रांची प्रत सीएजीएल कडे सादर करते. सीएजीएल ने मला कळवले आहे की माझे यासोबत सादर केलेले केवायसी वर नमूद केल्याखेरीज इतर कोणत्याही कारणासाठी किंवा कायद्याच्या आवश्यकतेशिवाय वापरले जाणार नाही मी येथे माझा फोटो, नांव, पत्ता आणि जीपीएस स्थान वेबसाइट आणि इतर माध्यमांद्वारे मार्केटींगच्या हेतूसाठी तसेच सीएजीएल यांचे वार्षिक अहवाल, मार्केटींग आणि प्रशिक्षण पुस्तिका, अंतर्गत किंवा बाह्य प्रकरण अभ्यासाचा उद्देश तृतीय पक्षीय सल्लागारांची छापिल प्रकाशने आणि / किंवा दृक-श्राव्य कार्यक्रमांमध्ये वापरण्यास परवानगी देते. मी माझ्या मोबाईल फोनवर सीएजीएलकडून सर्व प्रकारचे संप्रेषण प्राप्त करण्यास संमती देते.]]></text-property>
                    </text>
