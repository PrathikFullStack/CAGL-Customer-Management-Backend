                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[ಗ್ರಾಹಕರ ಮೂಲ KYC ಹಾಗೂ ಬ್ಯಾಂಕ್ ಪಾಸ್‌ಬುಕ್ ಅನ್ನು ನಾನು ಪರಿಶೀಲಿಸಿದ್ದೇನೆ ಎಂದು ನಾನು ಈ ಮೂಲಕ ದೃಢೀಕರಿಸುತ್ತೇನೆ.]]></text-property>
                    </text>
                    <text id="271">
                        <property name="fontFamily">serif</property>
                        <property name="fontSize">7pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[ವಿತರಿಸಲಾದ ಸಾಲವು ಸಿಎಜಿಎಲ್ ನ ESMS  ಪಾಲಿಸಿಗೆ ಅನುಸಾರವಾಗಿದೆ ಎಂದು ಈ ಮೂಲಕ ನಾನು ದೃಢೀಕರಿಸುತ್ತೇನೆ.]]></text-property>
                    </text>
