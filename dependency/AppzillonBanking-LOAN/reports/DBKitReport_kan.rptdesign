                    </grid>
                    <text id="191">
                        <property name="fontFamily">serif</property>
                        <property name="fontSize">8pt</property>
                        <property name="fontWeight">bold</property>
                        <property name="textUnderline">underline</property>
                        <property name="marginTop">0pt</property>
                        <property name="marginBottom">0pt</property>
                        <property name="paddingTop">0pt</property>
                        <property name="paddingBottom">0pt</property>
                        <property name="textAlign">left</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[ಸದಸ್ಯರ ಘೋಷಣೆ:]]></text-property>
                    </text>
                    <text-data id="912754">
                        <property name="fontFamily">serif</property>
                        <property name="fontSize">7pt</property>
                        <property name="paddingTop">0pt</property>
                        <property name="paddingBottom">0pt</property>
                        <expression name="valueExpr">if (&#13;
    params["pdtName"].value == "GL.IGL.VISH.LN" &#13;
    || params["pdtName"].value == "GL.GRM.VISH.SUPPL" &#13;
    || params["customerType"].value == "IL"&#13;
) {&#13;
&#13;
    "ನಾನು ಕ್ರೆಡಿಟ್ಆಕ್ಸೆಸ್ ಗ್ರಾಮೀಣ್ ಲಿಮಿಟೆಡ್ (ಇನ್ನು ಮುಂದೆ ಸಿಎಜಿಎಲ್ ಎಂದು ಉಲ್ಲೇಖಿಸಲಾಗುತ್ತದೆ), "&#13;
    &#13;
    + "&lt;b>" + params["branchName"].value + "&lt;/b> ಶಾಖೆಯು "&#13;
    + "&lt;b>" + params["apiResDateTime"].value.split(" ")[0] + "&lt;/b> ದಿನಾಂಕದ ರೂ. "&#13;
    + "&lt;b>Rs." + params["approvedAmtInRupees"].value + "&lt;/b> "&#13;
    + "(ರೂಪಾಯಿಗಳು &lt;b>" + params["approvedAmtInWord"].value + "&lt;/b>) "&#13;
&#13;
    + "ಯ ಪ್ರಾಮಿಸರಿ ನೋಟ್ ನ ವಿತರಣೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಲು ನಾನು ವಿನಂತಿಸುತ್ತೇನೆ, ಈ ಪರಿಗಣನೆಯನ್ನು ನಾನು ಸ್ವೀಕರಿಸಿದ್ದೇನೆ. "&#13;
&#13;
    + "ಈ ಮೂಲಕ ನನ್ನ ಸಾಲದ ಮೊತ್ತವನ್ನು &lt;b>" + params["term"].value + "&lt;/b> ಸಮನಾದ &lt;b>" &#13;
    + (&#13;
    params["paymentFreq"].value == "BI-WEEKLY" ? "2-weekly" :&#13;
    params["paymentFreq"].value == "FOUR-WEEKLY" ? "4-weekly" :&#13;
    params["paymentFreq"].value&#13;
  ) + "&lt;/b> ಕಂತುಗಳನ್ನು ಬಡ್ಡಿಯೊಂದಿಗೆ ಮರುಪಾವತಿ ಮಾಡಲು ಬದ್ದಳಾಗಿದ್ದೇನೆ. "&#13;
&#13;
    + "ನಾನು ಸಿಎಜಿಎಲ್ ನ ವೈಯಕ್ತಿಕ ಸದಸ್ಯಳಾಗಿ  ಸಾಲದ ಮೊತ್ತವನ್ನು ಪಡೆದಿದ್ದೇನೆ, ಎಂದು ಈ ಮೂಲಕ ದೃಢೀಕರಿಸುತ್ತೇನೆ."&#13;
&#13;
    + "ಸಿಎಜಿಎಲ್ ಸಿಬ್ಬಂದಿ ವಿವರಿಸಿರುವಂತೆ ಸಾಲದ ಮೊತ್ತ, ಬಡ್ಡಿದರ, ಕಂತಿನ ಮೊತ್ತ ಮತ್ತು ಮರುಪಾವತಿ ವೇಳಾಪಟ್ಟಿಯ ಮೇಲಿನ ನನ್ನ ಹಕ್ಕುಗಳನ್ನು ಮತ್ತು ಜವಾಬ್ದಾರಿಗಳನ್ನು ನಾನು ಪೂರ್ಣವಾಗಿ ಅರ್ಥ ಮಾಡಿಕೊಂಡಿದ್ದೇನೆ ಮತ್ತು ಅವರು ನನಗೆ ಪೂರ್ಣ ಸಮಾಧಾನ ತರುವಂತೆ ಸಾಲದ ಬಗೆಗಿನ ಎಲ್ಲ ವಿವರಗಳನ್ನೂ ಸ್ಪಷ್ಟಪಡಿಸಿದ್ದಾರೆ ಎಂದು ಮತ್ತೊಮ್ಮೆ ದೃಢೀಕರಿಸುತ್ತೇನೆ."&#13;
&#13;
    + "ನಾನು ಒಪ್ಪಿದ ವೇಳಾಪಟ್ಟಿ ಪ್ರಕಾರ ಸಾಲದ ಮೊತ್ತ ಮತ್ತು/ಅಥವಾ ಬಡ್ಡಿಯನ್ನು ಪಾವತಿಸಲು ಹೊಣೆಗಾರಳಾಗಿದ್ದೇನೆ, ಮತ್ತು ಅವರ ಬಾಕಿ ಹಣದ ವಸೂಲಾತಿಗಾಗಿ ಸಿಎಜಿಎಲ್ ನನ್ನ ವಿರುದ್ಧ ಸೂಕ್ತ ಕಾನೂನು ಕ್ರಮವನ್ನು ಕೈಗೊಳ್ಳಬಹುದು."&#13;
	+". ಸಾಲದ ದುರುಪಯೋಗ ಅಥವಾ ಯಾವುದೇ ಸಾಲದ ನಿಯಮಗಳ ಉಲ್ಲಂಘನೆಯ ಸಂದರ್ಭದಲ್ಲಿ ಬಾಕಿ ಹಣವನ್ನು ಹಿಂಪಡೆಯುವ ಹಕ್ಕು ಸಿಎಜಿಎಲ್ ಗೆ ಇರುತ್ತದೆ ಮತ್ತು ನಿರ್ಧಾರವನ್ನು ಅದರ ವಿವೇಚನೆಗೆ ಬಿಡಲಾಗಿರುತ್ತದೆ. ಇದಲ್ಲದೆ, ನಾನು ಮೇಲಿನ ಪ್ರಾಮಿಸರಿ ನೋಟ್ ಅನ್ನು ಕಾರ್ಯಗತಗೊಳಿಸಿದ್ದೇನೆ ಮತ್ತು ಈ ಸಮಯದಲ್ಲಿ ನಾನು ಸದ್ಬುದ್ಧಿಯಲ್ಲಿಯೂ ಹಾಗೂ  ಉತ್ತಮ ಆರೋಗ್ಯದಲ್ಲಿರುವಾಗ ಈ ಘೋಷಣೆ ಮಾಡಿದ್ದೇನೆ ಮತ್ತು ನಾನು ಈ ದಿನಾಂಕದಂದು ಯಾವುದೇ ಗಂಭೀರ ಅನಾರೋಗ್ಯದಿಂದ ಬಳಲುತ್ತಿಲ್ಲ ಎಂದು ಪ್ರಮಾಣೀಕರಿಸುತ್ತೇನೆ";&#13;
&#13;
} else {&#13;
&#13;
    "ನಾನು ಕ್ರೆಡಿಟ್ಆಕ್ಸೆಸ್ ಗ್ರಾಮೀಣ್ ಲಿಮಿಟೆಡ್ (ಇನ್ನು ಮುಂದೆ ಸಿಎಜಿಎಲ್ ಎಂದು ಉಲ್ಲೇಖಿಸಲಾಗುತ್ತದೆ), "&#13;
    &#13;
    + "&lt;b>" + params["branchName"].value + "&lt;/b> ಶಾಖೆಯು "&#13;
    + "&lt;b>" + params["apiResDateTime"].value.split(" ")[0] + "&lt;/b> ದಿನಾಂಕದ ರೂ. "&#13;
    + "&lt;b>Rs." + params["approvedAmtInRupees"].value + "&lt;/b> "&#13;
    + "(ರೂಪಾಯಿಗಳು &lt;b>" + params["approvedAmtInWord"].value + "&lt;/b>) "&#13;
&#13;
    + "ಯ ಪ್ರಾಮಿಸರಿ ನೋಟ್ ನ ವಿತರಣೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಲು ನಾನು ವಿನಂತಿಸುತ್ತೇನೆ. "&#13;
&#13;
    + "ಈ ಮೂಲಕ ನನ್ನ ಸಾಲದ ಮೊತ್ತವನ್ನು &lt;b>" + params["term"].value + "&lt;/b> ಸಮನಾದ &lt;b>" &#13;
    + (&#13;
    params["paymentFreq"].value == "BI-WEEKLY" ? "2-weekly" :&#13;
    params["paymentFreq"].value == "FOUR-WEEKLY" ? "4-weekly" :&#13;
    params["paymentFreq"].value&#13;
  ) + "&lt;/b> ಕಂತುಗಳನ್ನು ಬಡ್ಡಿಯೊಂದಿಗೆ ಮರುಪಾವತಿ ಮಾಡಲು ಬದ್ದಳಾಗಿದ್ದೇನೆ. "&#13;
&#13;
    + "ನಾನು ಸಿಎಜಿಎಲ್ ನ ಜಂಟಿ ಜವಾಬ್ದಾರಿ ಗುಂಪಿನ ಸದಸ್ಯಳಾಗಿಸಾಲವನ್ನು ಪಡೆದಿದ್ದೇನೆ ಎಂದು ಈ ಮೂಲಕ ದೃಢೀಕರಿಸುತ್ತೇನೆ."&#13;
&#13;
    + "ಸಿಎಜಿಎಲ್ ಸಿಬ್ಬಂದಿ ವಿವರಿಸಿರುವಂತೆ ಸಾಲದ ಮೊತ್ತ, ಬಡ್ಡಿದರ, ಕಂತಿನ ಮೊತ್ತ ಮತ್ತು ಮರುಪಾವತಿ ವೇಳಾಪಟ್ಟಿಯ ಮೇಲಿನ ನನ್ನ ಹಕ್ಕುಗಳನ್ನು ಮತ್ತು ಜವಾಬ್ದಾರಿಗಳನ್ನು ನಾನು ಪೂರ್ಣವಾಗಿ ಅರ್ಥ ಮಾಡಿಕೊಂಡಿದ್ದೇನೆ ಮತ್ತು ಅವರು ನನಗೆ ಪೂರ್ಣ ಸಮಾಧಾನ ತರುವಂತೆ ಸಾಲದ ಬಗೆಗಿನ ಎಲ್ಲ ವಿವರಗಳನ್ನೂ ಸ್ಪಷ್ಟಪಡಿಸಿದ್ದಾರೆ ಎಂದು ಮತ್ತೊಮ್ಮೆ ದೃಢೀಕರಿಸುತ್ತೇನೆ."&#13;
	+" ಆದ್ದರಿಂದ ಒಪ್ಪಿಕೊಂಡಿರುವಂತೆ ಸಮಯಕ್ಕೆ ಸರಿಯಾಗಿ ಸಾಲದ ಹಣವನ್ನು ಮತ್ತು ಅಥವಾ ಬಡ್ಡಿದರವನ್ನು ಪಾವತಿಸಲು ಗುಂಪಿನ ಇತರ ಸದಸ್ಯರೊಂದಿಗೆ ನಾನು ಪ್ರತ್ಯೇಕವಾಗಿಯೂ ಮತ್ತು ಜಂಟಿಯಾಗಿಯೂ ಜವಾಬ್ದಾರಿಯಾಗಿರುತ್ತೇನೆ ಮತ್ತು ಸಿಎಜಿಎಲ್ ಬಾಕಿ ಹಣವನ್ನು ಹಿಂಪಡೆಯಲು ನಮ್ಮ ವಿರುದ್ದ ಪ್ರತ್ಯೇಕವಾಗಿ/ ಜಂಟಿಯಾಗಿ ಸೂಕ್ತ ಕಾನೂನು ಕ್ರಮ ತೆಗೆದುಕೊಳ್ಳಬಹುದು. "&#13;
	+"ಸಾಲದ ದುರುಪಯೋಗ ಅಥವಾ ಯಾವುದೇ ಸಾಲದ ನಿಯಮಗಳ ಉಲ್ಲಂಘನೆಯ ಸಂದರ್ಭದಲ್ಲಿ ಬಾಕಿ ಹಣವನ್ನು ಹಿಂಪಡೆಯುವ ಹಕ್ಕು ಸಿಎಜಿಎಲ್ ಗೆ ಇರುತ್ತದೆ ಮತ್ತು ನಿರ್ಧಾರವನ್ನು ಅದರ ವಿವೇಚನೆಗೆ ಬಿಡಲಾಗಿರುತ್ತದೆ. ಇದಲ್ಲದೆ, ನಾನು ಮೇಲಿನ ಪ್ರಾಮಿಸರಿ ನೋಟ್ ಅನ್ನು ಕಾರ್ಯಗತಗೊಳಿಸಿದ್ದೇನೆ ಮತ್ತು ಈ ಸಮಯದಲ್ಲಿ ನಾನು ಸದ್ಬುದ್ಧಿಯಲ್ಲಿಯೂ ಹಾಗೂ  ಉತ್ತಮ ಆರೋಗ್ಯದಲ್ಲಿರುವಾಗ ಈ ಘೋಷಣೆ ಮಾಡಿದ್ದೇನೆ ಮತ್ತು ನಾನು ಈ ದಿನಾಂಕದಂದು ಯಾವುದೇ ಗಂಭೀರ ಅನಾರೋಗ್ಯದಿಂದ ಬಳಲುತ್ತಿಲ್ಲ ಎಂದು ಪ್ರಮಾಣೀಕರಿಸುತ್ತೇನೆ";&#13;
&#13;
}</expression>
                        <property name="contentType">html</property>
                    </text-data>
                    <text id="912751">
                        <property name="fontFamily">serif</property>
                        <property name="fontSize">7pt</property>
                        <property name="paddingTop">0pt</property>
                        <property name="paddingLeft">0pt</property>
                        <property name="paddingBottom">0pt</property>
                        <property name="paddingRight">0pt</property>
                        <property name="textAlign">justify</property>
                        <property name="contentType">html</property>
                        <text-property name="content"><![CDATA[ನನಗೆ ಉಲ್ಲೇಖಿಸದೆ ಸಾಲಗಳನ್ನು ಯಾವುದೇ ಬ್ಯಾಂಕ್/ ಹಣಕಾಸು ಸಂಸ್ಥೆಗೆ ಅಡಮಾನ ,ಮಾರಾಟ ,ನಿಯೋಜನೆ, ಭದ್ರತೆ ಅಥವಾ ವಿಲೇವಾರಿ ಮಾಡಲು ಸಿಎಜಿಎಲ್ ಗೆ ಇದರೊಂದಿಗೆ ನಾನು ಅಧಿಕಾರ ನೀಡುತ್ತೇನೆ. ಮೇಲೆ ತಿಳಿಸಲಾದ ಗುಂಪು ವಿಮಾ ಯೋಜನೆಯ ನಿಯಮಗಳು ಮತ್ತು ಷರತ್ತುಗಳನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಅರ್ಥಮಾಡಿಕೊಂಡ ನಂತರ, ನಾನು ಸ್ವಯಂಪ್ರೇರಣೆಯಿಂದ ನನ್ನನ್ನು/ಅಥವಾ ನನ್ನ ಸಂಗಾತಿಯನ್ನು ಸಿಎಜಿಎಲ್ ನಿರ್ವಹಿಸುವ ಗುಂಪು ವಿಮಾ ಯೋಜನೆಯಡಿಯಲ್ಲಿ ಮಾಸ್ಟರ್ ಪಾಲಿಸಿ ಹೋಲ್ಡರ್ (MPH) ಆಗಿ ನೋಂದಾಯಿಸಿಕೊಳ್ಳಲು ಆಯ್ಕೆ ಮಾಡಿಕೊಂಡಿದ್ದೇನೆ. ಯಾವುದೇ ದುರ್ಘಟನೆಯ ಸಂದರ್ಭದಲ್ಲಿ, ಯಾವುದೇ ಅನಿಶ್ಚಿತ ಘಟನೆಯ ಸಂದರ್ಭದಲ್ಲಿ ವಿಮಾ ಕಂಪನಿಯು ಕ್ಲೈಮ್‌ ಮೊತ್ತದ ವಿಭಜಿತ ಪಾವತಿಯನ್ನು, ಬಾಕಿ ಉಳಿದಿರುವ ಸಾಲಗಳ ಮಟ್ಟಿಗೆ, ಸಿಎಜಿಎಲ್ ಹೆಸರಿನಲ್ಲಿ ಮಾಡಲು, ಮತ್ತು ಕ್ಲೈಮ್‌ಗಳ ಉಳಿದ ಮೊತ್ತವನ್ನು ನಾಮನಿರ್ದೇಶಿತರ ಹೆಸರಿನಲ್ಲಿ ನೀಡಲು ನಾನು ಈ ಮೂಲಕ ನನ್ನ /ನಮ್ಮ ಒಪ್ಪಿಗೆಯನ್ನು ನೀಡುತ್ತಿದ್ದೇವೆ. ಎಲ್ಲಾ ಉದ್ಯಮದ ಸಂಘಗಳು, ಕ್ರೆಡಿಟ್ ಬ್ಯೂರೋ, ಕಂಪನಿಯ ಸಾಲದಾತರು, ಯಾವುದೇ ಶಾಸನಬದ್ಧ, ನಿಯಂತ್ರಣಾ ಮತ್ತು ರೇಟಿಂಗ್ ಏಜೆನ್ಸಿಗಳಿಗೆ, ನನ್ನ ವೈಯಕ್ತಿಕ ಮತ್ತು ಕ್ರೆಡಿಟ್ ಸಂಬಂಧಿತ ಮಾಹಿತಿಯನ್ನು ಬಹಿರಂಗಪಡಿಸಲು, ನಾನು ಸಿಎಜಿಎಲ್ ಗೆ ಸ್ವಇಚ್ಛೆಯಿಂದ ಅನುಮತಿ ನೀಡುತ್ತಿದ್ದೇನೆ ಮತ್ತು ಅವರು ಮೇಲೆ ತಿಳಿಸಿದ ಡೇಟಾ ಮತ್ತು ಮಾಹಿತಿಯನ್ನು, ನಿಯಂತ್ರಣ ಹಾಗೂ ಅನುಸರಣೆ ಸಂಬಂಧಿತ ಅವಶ್ಯಕತೆಗಳನ್ನು ಪೂರೈಸಲು, ಅಗತ್ಯವಿರುವ ರೀತಿಯಲ್ಲಿ ಬಳಸಬಹುದು. ನನ್ನ ಗುರುತು/ವಿಳಾಸದ ಪುರಾವೆಯನ್ನು ಸ್ಥಾಪಿಸಲು, ನಾನು ನನ್ನ KYCಯ ಪ್ರತಿಯನ್ನು ಸಿಎಜಿಎಲ್ ಗೆ ಈ ಮೂಲಕ ಸ್ವಯಂಪ್ರೇರಣೆಯಿಂದ ಸಲ್ಲಿಸುತ್ತೇನೆ. ಇಲ್ಲಿ ಸಲ್ಲಿಸಲಾದ ನನ್ನ KYCಯನ್ನು ಮೇಲೆ ತಿಳಿಸಿದ ಉದ್ದೇಶ ಅಥವಾ ಕಾನೂನಿನ ಆವಶ್ಯಕತೆಗಳನ್ನು ಹೊರತುಪಡಿಸಿ ಬೇರೆ ಯಾವುದೇ ಉದ್ದೇಶಕ್ಕಾಗಿ ಬಳಸುವುದಿಲ್ಲ ಎಂದು ಸಿಎಜಿಎಲ್ ನನಗೆ ತಿಳಿಸಿದೆ. ನನ್ನ ಛಾಯಾಚಿತ್ರ, ಹೆಸರು, ಕಥೆ ಮತ್ತು ಜಿಪಿಎಸ್ ಸ್ಥಳವನ್ನು ವೆಬ್‌ಸೈಟ್‌ಗಳು ಮತ್ತು ಇತರ ಮಾಧ್ಯಮಗಳಲ್ಲಿ, ಮಾರ್ಕೆಟಿಂಗ್ ಉದ್ದೇಶಗಳಿಗಾಗಿ ಪ್ರಕಟಿಸಲು ಮತ್ತು ಸಿಎಜಿಎಲ್ ನ ವಾರ್ಷಿಕ ವರದಿಗಳು, ಮಾರ್ಕೆಟಿಂಗ್ ಮತ್ತು ತರಬೇತಿ ಕರಪತ್ರಗಳು, ಅಂತರಿಕ ಅಥವಾ ಬಾಹ್ಯ ಉದ್ದೇಶಗಳಿಗಾಗಿ ಕೇಸ್ ಸ್ಟಡೀಸ್‌ (ಪ್ರಕರಣ ಅಧ್ಯಯನಗಳು), ಮೂರನೇ ವ್ಯಕ್ತಿ ಸಲಹೆಗಾರರ ಮುದ್ರಣ ಪ್ರಕಟಣೆಗಳು ಮತ್ತು / ಅಥವಾ ಶ್ರವ್ಯ-ದೃಶ್ಯ ಕಾರ್ಯಕ್ರಮಗಳಲ್ಲಿ ಬಳಸಲು, ನಾನು ಈ ಮೂಲಕ ಅನುಮತಿ ನೀಡುತ್ತೇನೆ . ನನ್ನ ಫೋನ್‌ನಲ್ಲಿ ಸಿಎಜಿಎಲ್  ನಿಂದ ಬರುವ  ಎಲ್ಲ ಬಗೆಯ ಸಂವಹನಗಳನ್ನು ಸ್ವೀಕರಿಸಲು ನಾನು ಒಪ್ಪಿಗೆ ನೀಡುತ್ತೇನೆ.]]></text-property>
                    </text>
