          : ""&#13;
        )&#13;
    : ""&#13;
) +&#13;
","+&#13;
params["apiResDateTime"].value +&#13;
" করা উক্ত ঋণের ঋণ আইডি" + params["LoanId"].value +&#13;
"এবং জীবন বীমা গ্রহণের জন্য আপনার সম্মতি হিসেবে ওটিপি" + params["otp"].value +&#13;
