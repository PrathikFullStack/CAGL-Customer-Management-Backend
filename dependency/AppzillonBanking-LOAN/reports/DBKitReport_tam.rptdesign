                                            <text-data id="912817">
                                                <property name="fontSize">7pt</property>
                                                <expression name="valueExpr">"அன்புள்ள " +&#13;
(&#13;
  params["insurancePremium"].value != 0&#13;
    ? params["borrowerName"].value +&#13;
        (params["spouseInsurance"].value == "YES"&#13;
          ? " மற்றும் " + params["coBorrowerName"].value&#13;
          : ""&#13;
        )&#13;
    : ""&#13;
) +&#13;
","+&#13;
params["apiResDateTime"].value +&#13;
"தேதியிட்ட கடன் ஐடி" + params["LoanId"].value +&#13;
" -இன் கீழ்  கடன் தொகை மற்றும் ஆயுள் காப்பீட்டைப் பெறுவதற்காக ஓடிபி" + params["otp"].value +&#13;
" -ஐப் பகிர்ந்து ஒப்புதல் வழங்கியதற்கு நன்றி. ஏதேனும் சந்தேகம் இருந்தால், கிராமீன் கூட்டாவை 1800123153153 என்ற எண்ணில் தொடர்புகொள்ளவும் - கிராமீன் கூடா "</expression>
                                                <property name="contentType">html</property>
                                            </text-data>
                                        </cell>
