    <property name="createdBy">Eclipse BIRT Designer Version 4.16.0.v202406131946</property>
    <property name="units">in</property>
    <method name="initialize"><![CDATA[numberToWords = function(num) { var a = ['', 'One ', 'Two ', 'Three ', 'Four ', 'Five ', 'Six ', 'Seven ', 'Eight ', 'Nine ', 'Ten ', 'Eleven ', 'Twelve ', 'Thirteen ', 'Fourteen ', 'Fifteen ', 'Sixteen ', 'Seventeen ', 'Eighteen ', 'Nineteen ']; var b = ['', '', 'Twenty ', 'Thirty ', 'Forty ', 'Fifty ', 'Sixty ', 'Seventy ', 'Eighty ', 'Ninety ']; var inWords = function(n) { if (n < 20) return a[n]; if (n < 100) return b[Math.floor(n / 10)] + a[n % 10]; if (n < 1000) return a[Math.floor(n / 100)] + 'Hundred ' + (n % 100 != 0 ? 'and ' + inWords(n % 100) : ''); return ''; }; var parts = parseFloat(num).toFixed(2).split('.'); var rupees = parseInt(parts[0]); var paise  = parseInt(parts[1]); var result = ''; if (rupees >= 10000000) { result += inWords(Math.floor(rupees / 10000000)) + 'Crore '; rupees %= 10000000; } if (rupees >= 100000)   { result += inWords(Math.floor(rupees / 100000))   + 'Lakh ';  rupees %= 100000;   } if (rupees >= 1000)     { result += inWords(Math.floor(rupees / 1000))     + 'Thousand '; rupees %= 1000;  } if (rupees > 0)         { result += inWords(rupees); } if (result) { result = result.trim() + ' Rupees'; } if (paise > 0) { result += (result ? ' and ' : '') + inWords(paise).trim() + ' Paise'; } if (!result) { result = 'Zero Rupees'; } return result.trim(); }]]></method>
