                                    <text-property name="content"><![CDATA[GSTயின் கீழ் நான் ]]></text-property>
                                </text>
                            </cell>
                            <cell id="202">
                                <property name="verticalAlign">middle</property>
                                <grid id="208">
                                    <property name="height">0.1597222222222222in</property>
                                    <property name="width">0.25in</property>
                                    <column id="209">
                                        <property name="width">0.25in</property>
                                    </column>
                                    <row id="210">
                                        <property name="height">0.1597222222222222in</property>
                                        <cell id="211">
                                            <property name="borderBottomColor">#808080</property>
                                            <property name="borderBottomStyle">solid</property>
                                            <property name="borderBottomWidth">1px</property>
                                            <property name="borderLeftColor">#808080</property>
                                            <property name="borderLeftStyle">solid</property>
                                            <property name="borderLeftWidth">1px</property>
                                            <property name="borderRightColor">#808080</property>
                                            <property name="borderRightStyle">solid</property>
                                            <property name="borderRightWidth">1px</property>
                                            <property name="borderTopColor">#808080</property>
