                    <text id="1922">
                        <property name="fontSize">8pt</property>
                        <property name="fontWeight">normal</property>
                        <property name="paddingTop">0pt</property>
                        <property name="paddingBottom">0pt</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[* सदस्याने विम्याची निवड न केल्यास, पती किंवा पत्नीचा विमा लागू होणार नाही. 
मी याद्वारे घोषित करतो]]></text-property>
                    </text>
                    <text id="1923">
                        <property name="fontSize">8pt</property>
                        <property name="textAlign">justify</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[मला प्रस्तावित कर्जाच्या प्रक्रिया शुल्क, व्याजदर आणि इतर अटी व शर्तींची माहिती आहे. मला हे देखील माहीत आहे की कर्ज मुदतपूर्व बंद करण्यासाठी कोणताही दंड / दंडात्मक शुल्क आकारले जात नाही. मी केंद्र सदस्य/ ब्रँच मॅनेजरला भेटू शकतो / शकते जर मला परतफेड करण्यासाठी काही वास्तविक समस्या असेल. मी कर्जाची रक्कम त्या विशिष्ट उद्देशासाठीच वापरण्याची हमी घेत आहे जसे वर नमुद केले आहे. मला माहित आहे की एका हप्त्याचा मोरॅटोरियम (फक्त मुद्दल) दिला जाईल. मी गट विमा योजनेच्या अटी व शर्ती पूर्णपणे समजून घेतल्यानंतर स्वैच्छिकपणे सदर गट विमा योजनेखाली नोंदणी करण्याचे निवडले आहे जी क्रेडिटऍक्सेस ग्रामीण लिमिटेड (यापुढे जे (CAGL) म्हणून नमुद केलेले आहे) यांनी मास्टर पॉलिसी होल्डर (MPH) म्हणून कार्यान्वित केलेली आहे.
]]></text-property>
                    </text>
                    <text id="1957">
                        <property name="fontSize">9pt</property>
                        <property name="fontWeight">bold</property>
                        <property name="textUnderline">underline</property>
                        <property name="borderBottomStyle">solid</property>
                        <property name="borderBottomWidth">1px</property>
                        <property name="borderLeftStyle">solid</property>
                        <property name="borderLeftWidth">1px</property>
                        <property name="borderRightStyle">solid</property>
                        <property name="borderRightWidth">1px</property>
                        <property name="borderTopStyle">solid</property>
                        <property name="borderTopWidth">1px</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[गट आणि केंद्र घोषणा*:]]></text-property>
                    </text>
                    <text id="1958">
                        <property name="fontSize">8pt</property>
                        <property name="borderBottomStyle">solid</property>
                        <property name="borderBottomWidth">1px</property>
                        <property name="borderLeftStyle">solid</property>
                        <property name="borderLeftWidth">1px</property>
                        <property name="borderRightStyle">solid</property>
                        <property name="borderRightWidth">1px</property>
                        <property name="borderTopStyle">solid</property>
                        <property name="borderTopWidth">1px</property>
                        <property name="textAlign">justify</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[आमचे केंद्र आणि गट याद्वारे वर नमुद सदस्याला कर्जाची रक्कम मंजूर करण्यासाठी CAGL यांना आमची थेट संमती देत आहे. आम्ही घोषित करतो की कर्जाच्या रकमेच्या परतफेडीच्या संदर्भाने आमच्यावर एक तत्व म्हणून बंधन आहे आणि एक हमी म्हणून नाही. आम्ही घोषित करतो की कर्जाची रक्कम आणि त्यावर लागू असलेले व्याज देण्याचे दायित्व हे सामूहिक आणि व्यक्तिगत प्रत्येक सदस्यासाठी असेल आणि त्याप्रमाणे आम्ही वर नमुद सदस्याद्वारे परतफेड करण्यात हलगर्जीपणा झाल्यास हे दायित्व पूर्णपणे अंमलात आणण्याची जबाबदारी घेतो. आम्ही यासाठी सहमत आहोत की CAGL कर्जाची रक्कम आणि त्यावर लागू असलेले व्याज प्रथम पाठपुरावा केल्याशिवाय आणि / किंवा उपलब्ध असलेले उपाय वर नमुद सदस्याविरूद्ध वापरल्याशिवाय गटाकडून वसूल करू शकतात. आम्ही एक गट म्हणून घोषित करतो की आम्ही यासाठी संपूर्ण जबाबदारी घेतो की कर्ज ज्या हेतूसाठी वितरित केलेले आहे त्याच हेतूसाठी वापरले जाईल. कर्जाचा गैरवापर झाल्यास आम्ही कर्जाची रक्कम CAGL यांना ताबडतोब परत करण्याची जबाबदारी घेतो.

स्वाक्षरी:                गट नेता:____________________________               केंद्रप्रमुख:__________________________
]]></text-property>
                    </text>
                    <text id="1976">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[
*विशेष ग्राहकांना लागू होत नाही.
“व्याजाचा दर कर्जदाराचा CAGL शी असलेला संबंध आणि भौगोलिक स्वरूपाचे क्रेडिट धोक्याचे मूल्यांकनावर आधारित भिन्न असू शकतो.”
]]></text-property>
                    </text>
                    <text id="1977">
                        <property name="fontSize">9pt</property>
                        <property name="fontWeight">bold</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[मंजुरीच्या अटी व शर्ती]]></text-property>
                    </text>
                    <text id="1978">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[1. कर्जाची रक्कम परतफेड कालावधी आणि वारंवारतेनुसार व्याजासह हप्त्याने परत करावी लागेल.]]></text-property>
                    </text>
                    <text id="1993">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[2.CAGL सल्ल्यानुसार कर्जदाराचा व्याजदर वेळोवेळी सुधारित करणे विचारात घेऊ शकतात आणि कर्जदार असा सुधारित व्याजदर संभाव्यतेने भरण्याची हमी घेत आहे.]]></text-property>
                    </text>
                    <text id="1992">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[3. कर्जाची रक्कम सदस्याला क्रेडिटऍक्सेस ग्रामीण लिमिटेड (यापुढे जे सीएजीएल म्हणून नमुद केलेले आहे) यांच्या संयुक्त दायित्व गटाचा सदस्य म्हणून वितरित केली जाईल.]]></text-property>
                    </text>
                    <text id="1991">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[4. विशेष कर्जाचे ग्राहक संयुक्त दायित्व गटाचे भाग नसतील.]]></text-property>
                    </text>
                    <text id="2312">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[5. ग्राहकाने केंद्राच्या सर्व बैठकांना उपस्थित राहावे, कर्जाचा वापर फक्त मान्य केलेल्या उद्देशासाठीच करावा, कर्जाचे हप्ते त्वरित फेडावेत, केंद्र सदस्यांना काही समस्या आल्यास त्यांना मदत करावी आणि परतफेडीच्या क्षमतेपेक्षा जास्त कर्ज घेऊ नये.]]></text-property>
                    </text>
                    <text id="1990">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[6. मान्य केलेल्या वेळापत्रकानुसार कर्जाची रक्कम आणि/किंवा व्याज भरण्यासाठी ग्राहक समूहाच्या इतर सदस्यांसह विविध आणि संयुक्तपणे जबाबदार असेल.]]></text-property>
                    </text>
                    <text id="1989">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[7. कर्जाचा गैरवापर झाल्यास किंवा कर्जाच्या कोणत्याही अटींचे उल्लंघन झाल्यास CAGL ला कर्ज परत घेण्याचा अधिकार आहे.]]></text-property>
                    </text>
                    <text id="1988">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[8. CAGLकर्जदाराच्या गोपनीयतेचा आदर केला जाईल याची खात्री देतो. सर्व कर्जे क्रेडिट ब्युरो तपासणीच्या अधीन असतील म्हणून डेटा क्रेडिट ब्युरो एजन्सीसह सामायिक केला जाईल.]]></text-property>
                    </text>
                    <text id="1987">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[9.  कर्ज मुदतपूर्व बंद करणे किंवा कर्जाच्या आंशिक पेमेंटसाठी किंवा हप्त्यासाठी कोणतेही शुल्क आकारले जात नाही.]]></text-property>
                    </text>
                    <text id="1986">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[10. प्रत्येक कर्जावर एका हप्त्याचा अधिस्थगन (केवळ मुद्दल) दिला जाईल.]]></text-property>
                    </text>
                    <text id="1985">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[11. कर्जाची मंजूरी सीएजीएल किंवा तृतीय पक्षाद्वारे प्रस्तावित केलेल्या इतर कोणत्याही उत्पादनाशी / सेवांशी संलग्न नाही.]]></text-property>
                    </text>
                    <text id="1984">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[12.  सीएजीएल आपल्या कर्मचाऱ्यांच्या कोणत्याही अनुचित वर्तनास प्रतिबंध करण्यास आणि वेळेवर तक्रार निवारण करण्यासाठी जबाबदार आहे.]]></text-property>
                    </text>
                    <text id="1983">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[13. सीएजीएल कर्जासाठी कोणतीही सुरक्षा ठेव किंवा मार्जिन मनी जमा करणार नाही.]]></text-property>
                    </text>
                    <text id="1982">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[14. अर्ज केल्याच्या तारखेपासून 15 दिवसांच्या आत कर्ज वाटप न झाल्यास, CAGL घरातील कमावत्या सदस्यांची CB स्थिती पुन्हा तपासू शकते.]]></text-property>
                    </text>
                    <text id="1981">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[15. ग्राहकाने निवडलेल्या परतफेडीच्या कालावधीनुसार साप्ताहिक/द्विसाप्ताहिक/चार साप्ताहिक विश्रांतीसह शिल्लक कमी करण्यावर व्याज मोजले जाईल.]]></text-property>
                    </text>
                    <text id="1980">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[16. कर्जाच्या हप्त्याची परतफेड करण्याची देय तारीख आणि मुद्दल आणि व्याजाचे विभाजन कर्ज पासबुकमध्ये दिले जाईल, कर्ज परतफेडीच्या वेळापत्रकासाठी कर्ज पासबुक पहा.]]></text-property>
                    </text>
                    <text id="1979">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[17. कर्जाच्या किंमतीबाबत तपशीलवार तथ्य पत्रक दिले जाईल.]]></text-property>
                    </text>
                    <text id="1994">
                        <property name="fontSize">x-small</property>
                        <property name="contentType">auto</property>
                        <text-property name="content"><![CDATA[18.  जर कर्ज खाते 90 दिवसांपेक्षा जास्त काळ थकबाकीदार राहिले तर ते एनपीए म्हणून मानले जाईल आणि क्रेडिट ब्युरोला तसा अहवाल दिला जाईल.]]></text-property>
                    </text>
