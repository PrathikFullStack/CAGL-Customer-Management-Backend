                                                    </structure>
                                                </list-property>
                                                <expression name="valueExpr">"ಆತ್ಮೀಯ " +&#13;
(&#13;
  params["insurancePremium"].value != 0&#13;
    ? params["borrowerName"].value +&#13;
        (params["spouseInsurance"].value == "YES"&#13;
          ? " ಮತ್ತು " + params["coBorrowerName"].value&#13;
          : ""&#13;
        )&#13;
    : ""&#13;
) +&#13;
", ಸಾಲದ ID " + params["LoanId"].value +&#13;
" ಮತ್ತು ಸದರಿ ಸಾಲದ ಅಡಿಯಲ್ಲಿ " + params["apiResDateTime"].value +&#13;
" ರಂದು ಜೀವ ವಿಮೆಯನ್ನು ಪಡೆಯಲು ನಿಮ್ಮ ಸಮ್ಮತಿಯಾಗಿ OTP " +&#13;
