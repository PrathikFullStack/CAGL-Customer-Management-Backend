        <text id="50">
            <property name="contentType">html</property>
            <text-property name="content"><![CDATA[
                <p>
                We acknowledge the receipt of your pre-closure payment of Rs/- <value-of>params["preclosureAmount"].value</value-of> towards the pre-closure of your loan account mentioned below. We hereby confirm that there are no remaining outstanding payments for the aforementioned loan account in our records.
                </p>
            ]]></text-property>
